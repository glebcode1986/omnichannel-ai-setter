# Prisma CLI settings for packages/db. Prisma 7 does not load .env files automatically: export these in your
# shell (or prefix commands) before running `pnpm --filter @omnichannel/db db:*`. Never commit real values.

# Database the CLI migrates (local compose.yaml service).
DATABASE_URL=postgresql://omnichannel:omnichannel-local-only@127.0.0.1:54329/omnichannel

# Scratch database used by `db:migrate:dev` and `db:check-drift`; create it once with
# `docker compose exec postgres createdb -U omnichannel omnichannel_shadow`.
SHADOW_DATABASE_URL=postgresql://omnichannel:omnichannel-local-only@127.0.0.1:54329/omnichannel_shadow

# Server for integration tests; each test file creates and drops its own database there.
TEST_DATABASE_URL=postgresql://omnichannel:omnichannel-local-only@127.0.0.1:54329/omnichannel
