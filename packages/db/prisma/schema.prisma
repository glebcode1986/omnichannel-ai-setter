  PENDING
  RESOLVED_SENT
  RESOLVED_RESUMED
  NEEDS_HUMAN
  ALREADY_SETTLED
}

enum SuspensionScope {
  GLOBAL
  WORKSPACE
  BUSINESS_PROFILE
  CHANNEL_ACCOUNT
}

enum SuspensionReason {
  OPERATOR
  DEPENDENCY_FAILURE
  CHANNEL_UNHEALTHY
  BACKLOG
}

enum ReplyLength {
  SHORT
  MEDIUM
  LONG
}

enum EmojiUsage {
  NONE
  SPARING
  FREELY
}

enum StyleExampleProvenance {
  HUMAN_TYPED
  HUMAN_EDITED_DRAFT
}

/// What somebody decided about a style example, as distinct from where it ended up (#32).
enum StyleDecision {
  APPROVED
  REJECTED
  ARCHIVED
  RESTORED
}

enum StyleExampleStatus {
  /// In use for tone. A CHECK requires an approver, because "verified" with nobody's name on it is not.
  ACTIVE
  /// Noticed by the system and inert until a person activates it. Retrieval filters on ACTIVE only.
  SUGGESTED
  /// Judged and declined. Kept rather than deleted, so the decision is auditable.
  REJECTED
  ARCHIVED
}

enum InstagramAfterWindowPolicy {
  STANDARD_ONLY
  HUMAN_ASSISTED_EXTENDED
}

enum WhatsAppAfterWindowPolicy {
  SERVICE_WINDOW_ONLY
  TEMPLATE_REVIEW
  TEMPLATE_AUTOPILOT
}

// ---------------------------------------------------------------------------------------------------------
// Auth.js persistence (@auth/prisma-adapter). Login identity only; workspace authorization is separate.
// OAuth access/refresh/id tokens are deliberately not persisted (the web adapter strips them).
// ---------------------------------------------------------------------------------------------------------

model User {
  id            String    @id @default(uuid(7))
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  /// BCP-47 tag, canonicalized on write. NULL means the product's fallback locale.
  uiLocale      String?   @map("ui_locale")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts                  Account[]
  sessions                  Session[]
  memberships               WorkspaceMember[]
  sentMessages              Message[]
  takenOverConversations    Conversation[]
  createdKnowledgeDocuments KnowledgeDocument[]
  approvedStyleExamples     StyleExample[]
  channelConnectStates      ChannelConnectState[]
  requestedAiDrafts         AiDraft[]             @relation("DraftRequestedBy")
  automationSuspensions     AutomationSuspension[] @relation("SuspensionBy")
  liftedSuspensions         AutomationSuspension[] @relation("SuspensionLiftedBy")
  approvedDeliveries        DeliveryJobRecord[]
  composedDeliveries        DeliveryJobRecord[]   @relation("ComposedDeliveries")
  onboardingSkips           OnboardingSkip[]
  policyChangeAudits        PolicyChangeAudit[]
  confirmedCustomerFacts    CustomerFact[]            @relation("CustomerFactConfirmer")
  confirmedCustomerPreferences CustomerPreference[]   @relation("CustomerPreferenceConfirmer")
  dismissedDuplicates      DuplicateContactCandidate[] @relation("DuplicateCandidateDismisser")
  assignedLeads             Conversation[]            @relation("LeadAssignee")
  leadStageTransitions      LeadStageTransition[]     @relation("LeadStageActor")
  openedCheckouts           CheckoutContract[]        @relation("CheckoutActor")
  platformMembership        PlatformMember?           @relation("PlatformMemberUser")
  proposedReleases          ReleaseRecord[]           @relation("ReleaseActor")
  legalAcceptances          LegalAcceptance[]         @relation("AcceptanceActor")
  leadQualificationAnswers  LeadQualificationAnswer[] @relation("LeadQualificationActor")

  styleExampleDecisions     StyleExample[]         @relation("StyleExampleDecider")
  styleDecisionsMade        StyleExampleDecision[]

  auditEvents        AuditEvent[]
  goalsSet             ConversationGoal[]
  followUpsCreated     FollowUp[]
  tasksAssigned        HumanTask[] @relation("HumanTaskAssignee")
  tasksCreated         HumanTask[] @relation("HumanTaskCreator")
  tasksCompleted       HumanTask[] @relation("HumanTaskCompleter")
  suppressionsRecorded FollowUpSuppression[] @relation("SuppressionRecorder")
  suppressionsLifted   FollowUpSuppression[] @relation("SuppressionLifter")
  @@map("users")
  deletionRequests DeletionRequest[]
  entitlementOverrides EntitlementOverride[]
}

model Account {
  userId            String   @map("user_id")
  type              String
  provider          String
  providerAccountId String   @map("provider_account_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([provider, providerAccountId])
  @@index([userId])
  @@map("auth_accounts")
}

model Session {
  sessionToken String   @id @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@index([userId])
  @@map("auth_sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("auth_verification_tokens")
}

// ---------------------------------------------------------------------------------------------------------
// Tenancy: Workspace (tenant/billing boundary) -> Business Profile (operational/customer-data boundary)
// ---------------------------------------------------------------------------------------------------------

model Workspace {
  id        String   @id @default(uuid(7))
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members            WorkspaceMember[]
  businessProfiles   BusinessProfile[]
  channelCredentials ChannelCredential[]
  knowledgeDocuments KnowledgeDocument[]
  styleExamples      StyleExample[]
  styleProfiles      StyleProfile[]
  usageCycles        UsageCycle[]
  workspaceAddOns    WorkspaceAddOn[]
  usageTopUps        UsageTopUp[]
  usageLedgerEntries UsageLedgerEntry[]
  usageCounters      UsageCounter[]
  usageReservations  UsageReservation[]
  policyChangeAudits PolicyChangeAudit[]
  styleExampleDecisions StyleExampleDecision[]
  leadStageDisplays  LeadStageDisplay[]
  leadStageTransitions LeadStageTransition[]
  leadQualificationAnswers LeadQualificationAnswer[]

  auditEvents        AuditEvent[]
  conversationGoals    ConversationGoal[]
  followUps            FollowUp[]
  humanTasks           HumanTask[]
  followUpSuppressions FollowUpSuppression[]
  deletionRequests     DeletionRequest[]
  subscription         WorkspaceSubscription?
  entitlementOverride  EntitlementOverride?
  billingAccount       BillingAccount?
  billingArrangements  BillingArrangement[]
  checkoutContracts    CheckoutContract[]
  legalAcceptances     LegalAcceptance[]
  billingEvents        BillingEvent[]
  supportAccessSessions SupportAccessSession[]
  platformAuditEvents  PlatformAuditEvent[]
  @@map("workspaces")
}

/// Role answers what a member may do; business_profile_scope answers where (TEAM_ROLES_UX.md).
/// ALL covers every current and future Business Profile; SELECTED covers only explicit grants.
model WorkspaceMember {
  id                   String                     @id @default(uuid(7))
  workspaceId          String                     @map("workspace_id")
  userId               String                     @map("user_id")
  role                 WorkspaceRole
  businessProfileScope BusinessProfileAccessScope @default(SELECTED) @map("business_profile_scope")
  createdAt            DateTime                   @default(now()) @map("created_at")
  updatedAt            DateTime                   @updatedAt @map("updated_at")

  workspace             Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  user                  User                          @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  businessProfileAccess MemberBusinessProfileAccess[]

  @@unique([workspaceId, userId])
  @@unique([workspaceId, id])
  @@index([userId])
  @@map("workspace_members")
}

/// A Business Profile inside a Workspace. INACTIVE preserves data; it is not deletion (DATA_MODEL.md v0.4 §2).
model BusinessProfile {
  id          String                @id @default(uuid(7))
  workspaceId String                @map("workspace_id")
  name        String
  status      BusinessProfileStatus @default(SETUP)
  /// Whether this profile is on the explicit list §18 of LAUNCH_READINESS.md calls for at the
  /// `LIMITED_AUTOPILOT` stage (#60).
  ///
  /// Consulted at that one stage and nowhere else: before it nobody sends unattended whatever this says,
  /// and from `COMMERCIAL_BETA` onwards the plan governs — a rollout that kept an allowlist for ever
  /// would be a permanent gate wearing a temporary name. Defaults to false, because the spec's own
  /// default is DRAFT and AUTOPILOT "requires explicit enablement".
  rolloutAutopilot Boolean           @default(false) @map("rollout_autopilot")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  workspace          Workspace                     @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  memberAccess       MemberBusinessProfileAccess[]
  channelAccounts    ChannelAccount[]
  contacts           Contact[]
  knowledgeDocuments KnowledgeDocument[]
  styleExamples      StyleExample[]
  styleProfiles      StyleProfile[]
  automationPolicies AutomationPolicy[]
  queueOutbox        QueueOutbox[]
  connectStates      ChannelConnectState[]
  onboardingSkips    OnboardingSkip[]
  policyChangeAudits PolicyChangeAudit[]

  auditEvents        AuditEvent[]
  humanTasks           HumanTask[]
  whatsappConnections WhatsAppConnection[]
  supportAccessSessions SupportAccessSession[]
  platformAuditEvents  PlatformAuditEvent[]
  @@unique([workspaceId, id])
  @@index([workspaceId, status])
  @@map("business_profiles")
}

/// A person's decision to pass over an optional setup step (Issue #27).
///
/// The only part of onboarding that is stored. Every other step's completion is read from the
/// configuration it produced — the channel account, the policy row, the knowledge documents — so there is
/// no second copy of progress to drift from reality. A deliberate skip is the one fact the data cannot
/// reveal on its own: "no style yet" and "we decided not to write one" look identical in a style table.
model OnboardingSkip {
  id                String          @id @default(uuid(7))
  workspaceId       String          @map("workspace_id")
  businessProfileId String          @map("business_profile_id")
  step              OnboardingStep
  /// Who decided. A skip is an operational decision and the audit question is always who made it.
  skippedByUserId   String          @map("skipped_by_user_id")
  createdAt         DateTime        @default(now()) @map("created_at")

  businessProfile BusinessProfile @relation(fields: [workspaceId, businessProfileId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  skippedBy       User            @relation(fields: [skippedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// One row per step: skipping twice is the same decision, not two.
  @@unique([workspaceId, businessProfileId, step])
  @@index([workspaceId, businessProfileId])
  @@map("onboarding_skips")
}

/// Explicit Business Profile grant for a SELECTED-scope member. Member and profile must share the Workspace.
/// Grants are access configuration, not history: they are removed with their membership.
model MemberBusinessProfileAccess {
  id                String   @id @default(uuid(7))
  workspaceId       String   @map("workspace_id")
  workspaceMemberId String   @map("workspace_member_id")
  businessProfileId String   @map("business_profile_id")
  createdAt         DateTime @default(now()) @map("created_at")

  member          WorkspaceMember @relation(fields: [workspaceId, workspaceMemberId], references: [workspaceId, id], onDelete: Cascade, onUpdate: Restrict)
  businessProfile BusinessProfile @relation(fields: [workspaceId, businessProfileId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([workspaceMemberId, businessProfileId])
  @@index([workspaceId, businessProfileId])
  @@map("member_business_profile_access")
}

// ---------------------------------------------------------------------------------------------------------
// Channels
// ---------------------------------------------------------------------------------------------------------

/// Encrypted credential placeholder. Plaintext tokens are never stored; encryption/key management and the
/// Meta token lifecycle are implemented by the onboarding tasks. `keyId` names the encryption key version.
/// Workspace-scoped because it is reached only through its (Business Profile owned) channel account.
model ChannelCredential {
  id          String    @id @default(uuid(7))
  workspaceId String    @map("workspace_id")
  /// What the ciphertext is, bound into its additional authenticated data so it cannot be reinterpreted.
  purpose     String    @default("INSTAGRAM_ACCESS_TOKEN")
  keyId       String    @map("key_id")
  algorithm   String
  ciphertext  Bytes
  nonce       Bytes
  authTag     Bytes?    @map("auth_tag")
  expiresAt   DateTime? @map("expires_at")
  /// When the current token was minted; Meta refuses to refresh a token younger than 24 hours.
  refreshedAt DateTime? @map("refreshed_at")
  /// Set on disconnect. The row stays so audit history keeps its reference; the secret is cleared.
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  channelAccount ChannelAccount?

  @@unique([workspaceId, id])
  @@map("channel_credentials")
}

model ChannelAccount {
  id                String               @id @default(uuid(7))
  workspaceId       String               @map("workspace_id")
  businessProfileId String               @map("business_profile_id")
  channel           ChannelType
  externalAccountId String               @map("external_account_id")
  displayName       String?              @map("display_name")
  credentialId      String?              @map("credential_id")
  status            ChannelAccountStatus @default(CONNECTED)
  capabilities      Json                 @default("{}")
  defaultAiMode     AiMode               @default(OFF) @map("default_ai_mode")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  businessProfile    BusinessProfile    @relation(fields: [workspaceId, businessProfileId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  credential         ChannelCredential? @relation(fields: [workspaceId, credentialId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  channelIdentities  ChannelIdentity[]
  inboundEvents      InboundEvent[]
  automationPolicies AutomationPolicy[]
  whatsappConnection WhatsAppConnection?

  @@unique([workspaceId, businessProfileId, id])
  @@unique([workspaceId, credentialId])
  /// One live connection per platform account, so webhooks route to exactly one Workspace + Business Profile.
  @@unique([channel, externalAccountId], where: raw("status <> 'DISCONNECTED'"), map: "channel_accounts_live_external_account_key")
  /// Packaging: a Business Profile initially owns at most one live account per channel (DATA_MODEL.md v0.4 §3).
  @@unique([workspaceId, businessProfileId, channel], where: raw("status <> 'DISCONNECTED'"), map: "channel_accounts_live_profile_channel_key")
  @@index([channel, externalAccountId])
  @@map("channel_accounts")
}

/// Idempotency ledger for verified provider events: one row per (channel account, source event).
/**
 * One in-flight Instagram Login attempt. The row is the authority for the OAuth `state`: it is single-use,
 * expires quickly, and remembers which member of which Business Profile started the flow so the callback
 * cannot be replayed into another tenant. The browser cookie holds only a nonce whose hash is stored here,
 * so neither half alone completes a connection.
 */
model ChannelConnectState {
  /// The opaque `state` value handed to Meta.
  id                String      @id
  workspaceId       String      @map("workspace_id")
  businessProfileId String      @map("business_profile_id")
  /// Member who started the flow; the callback must be completed by the same person.
  userId            String      @map("user_id")
  channel           ChannelType
  /// SHA-256 of the cookie nonce. The nonce itself is never stored.
  nonceHash         Bytes       @map("nonce_hash")
  requestedScopes   String[]    @map("requested_scopes")
  expiresAt         DateTime    @map("expires_at")
  consumedAt        DateTime?   @map("consumed_at")
  createdAt         DateTime    @default(now()) @map("created_at")

  businessProfile BusinessProfile @relation(fields: [workspaceId, businessProfileId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  user            User            @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([expiresAt])
  @@map("channel_connect_states")
}

model InboundEvent {
  id                String           @id @default(uuid(7))
  workspaceId       String           @map("workspace_id")
  businessProfileId String           @map("business_profile_id")
  channelAccountId  String           @map("channel_account_id")
  sourceEventId     String           @map("source_event_id")
  eventType         ChannelEventType @map("event_type")
  occurredAt        DateTime         @map("occurred_at")
  receivedAt        DateTime         @default(now()) @map("received_at")
  processedAt       DateTime?        @map("processed_at")
  /// Correlation ID of the webhook request that first recorded the event.
  correlationId     String?          @map("correlation_id")
  /// Audit of what ingestion did with the event (application IngestionOutcome).
  outcome           String?

  channelAccount ChannelAccount @relation(fields: [workspaceId, businessProfileId, channelAccountId], references: [workspaceId, businessProfileId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([workspaceId, businessProfileId, channelAccountId, sourceEventId], map: "inbound_events_source_event_key")
  @@index([workspaceId, receivedAt])
  @@map("inbound_events")
}

// ---------------------------------------------------------------------------------------------------------
// Customer identity and conversations (Business Profile owned)
// ---------------------------------------------------------------------------------------------------------

/// Canonical customer inside one Business Profile; there is no cross-profile customer graph.
model Contact {
  id                String   @id @default(uuid(7))
  workspaceId       String   @map("workspace_id")
  businessProfileId String   @map("business_profile_id")
  displayName       String?  @map("display_name")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  businessProfile   BusinessProfile   @relation(fields: [workspaceId, businessProfileId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  channelIdentities ChannelIdentity[]
  conversations     Conversation[]
  contactPoints     ContactPoint[]
  externalIdentities ExternalIdentity[]
  customerFacts      CustomerFact[]
  customerPreferences CustomerPreference[]
  duplicateCandidates DuplicateContactCandidate[] @relation("DuplicateCandidateContact")
  duplicateCandidateOf DuplicateContactCandidate[] @relation("DuplicateCandidateOther")

  followUpSuppressions FollowUpSuppression[]
  @@unique([workspaceId, businessProfileId, id])
  @@map("contacts")
}

/// Provider identity of a contact on one channel account of the same Business Profile. The stable provider
/// user ID is the key; username/display name are mutable attributes, never identity evidence.
model ChannelIdentity {
  id                String   @id @default(uuid(7))
  workspaceId       String   @map("workspace_id")
  businessProfileId String   @map("business_profile_id")
  contactId         String   @map("contact_id")
  channelAccountId  String   @map("channel_account_id")
  externalUserId    String   @map("external_user_id")
  displayName       String?  @map("display_name")
  username          String?
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  contact        Contact        @relation(fields: [workspaceId, businessProfileId, contactId], references: [workspaceId, businessProfileId, id], onDelete: Restrict, onUpdate: Restrict)
  channelAccount ChannelAccount @relation(fields: [workspaceId, businessProfileId, channelAccountId], references: [workspaceId, businessProfileId, id], onDelete: Restrict, onUpdate: Restrict)
  conversations  Conversation[]

  @@unique([workspaceId, businessProfileId, channelAccountId, id])
  /// External identity lookup: a provider user maps to one identity per channel account (hence per profile).
  @@unique([workspaceId, businessProfileId, channelAccountId, externalUserId], map: "channel_identities_external_user_key")
  @@index([workspaceId, businessProfileId, contactId])
  @@map("channel_identities")
}

model Conversation {
  id                        String             @id @default(uuid(7))
  workspaceId               String             @map("workspace_id")
  businessProfileId         String             @map("business_profile_id")
  channelAccountId          String             @map("channel_account_id")
  contactId                 String             @map("contact_id")
  channelIdentityId         String             @map("channel_identity_id")
  modeOverride              AiMode?            @map("mode_override")
  aiEnabled                 Boolean            @default(true) @map("ai_enabled")
  takeoverState             TakeoverState      @default(NONE) @map("takeover_state")
  takeoverReason            TakeoverReason?    @map("takeover_reason")
  takeoverReviewMode        ReviewMode?        @map("takeover_review_mode")
  humanTakeoverAt           DateTime?          @map("human_takeover_at")
  takeoverPausedUntil       DateTime?          @map("takeover_paused_until")
  takeoverActorKind         ActorKind?         @map("takeover_actor_kind")
  takeoverActorUserId       String?            @map("takeover_actor_user_id")
  /// Window/eligibility snapshot kept for Human Agent review audit; re-evaluated before any final send.
  reviewEligibilitySnapshot Json?              @map("review_eligibility_snapshot")
  leadStage                 LeadStage          @default(NEW) @map("lead_stage")
  status                    ConversationStatus @default(OPEN)
  /// Optimistic-concurrency anchor: increases with material changes that make anchored actions stale.
  stateVersion              Int                @default(0) @map("state_version")
  lastInboundAt             DateTime?          @map("last_inbound_at")
  lastOutboundAt            DateTime?          @map("last_outbound_at")
  /// Inbox ordering: latest message activity (creation time until the first message).
  lastMessageAt             DateTime           @default(now()) @map("last_message_at")
  /// The person who owns this lead. Distinct from `takeoverActorUser`, which is who is holding the
  /// conversation right now: an assignee stays after they hand the thread back to automation.
  assignedUserId            String?            @map("assigned_user_id")
  leadTags                  String[]           @default([]) @map("lead_tags")
  leadNote                  String?            @map("lead_note")
  nextAction                String?            @map("next_action")
  nextActionAt              DateTime?          @map("next_action_at")
  createdAt                 DateTime           @default(now()) @map("created_at")
  updatedAt                 DateTime           @updatedAt @map("updated_at")

  channelIdentity   ChannelIdentity @relation(fields: [workspaceId, businessProfileId, channelAccountId, channelIdentityId], references: [workspaceId, businessProfileId, channelAccountId, id], onDelete: Restrict, onUpdate: Restrict)
  contact           Contact         @relation(fields: [workspaceId, businessProfileId, contactId], references: [workspaceId, businessProfileId, id], onDelete: Restrict, onUpdate: Restrict)
  takeoverActorUser User?           @relation(fields: [takeoverActorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignedUser      User?           @relation("LeadAssignee", fields: [assignedUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "conversations_assigned_user_fkey")
  messages          Message[]
  aiDrafts          AiDraft[]
  leadStageTransitions LeadStageTransition[]
  leadQualificationAnswers LeadQualificationAnswer[]
  composedDeliveries DeliveryJobRecord[]

  summary                  ConversationSummary?

  goals                ConversationGoal[]
  followUps            FollowUp[]
  humanTasks           HumanTask[]
  @@unique([workspaceId, businessProfileId, id])
  @@unique([workspaceId, businessProfileId, channelAccountId, id])
  /// One thread per provider participant per channel account (platform DM threads are 1:1).
  @@unique([workspaceId, businessProfileId, channelAccountId, channelIdentityId], map: "conversations_channel_identity_key")
  @@index([workspaceId, businessProfileId, status, lastMessageAt(sort: Desc)], map: "conversations_profile_inbox_idx")
  @@index([channelAccountId, lastInboundAt])
  @@map("conversations")
}

/// How one Workspace shows one stage. A missing row means the product default (LEADS_ANALYTICS_UX.md).
model LeadStageDisplay {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @map("workspace_id")
  stage       LeadStage
  label       String
  position    Int
  /// Hidden, never deleted: leads already sitting in a hidden stage must stay reachable.
  hidden      Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "lead_stage_displays_workspace_fkey")

  @@unique([workspaceId, stage], map: "lead_stage_displays_stage_key")
  @@unique([workspaceId, position], map: "lead_stage_displays_position_key")
  @@map("lead_stage_displays")
}

/// Every stage change, with who caused it. A CHECK pairs the actor with the source.
model LeadStageTransition {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String          @map("workspace_id")
  businessProfileId String          @map("business_profile_id")
  conversationId    String          @map("conversation_id")
  /// NULL for the first recorded transition: earlier history predates this table.
  fromStage         LeadStage?      @map("from_stage")
  toStage           LeadStage       @map("to_stage")
  source            LeadValueSource
  /// Set exactly when a person did it; an AI suggestion has no actor to name.
  actorUserId       String?         @map("actor_user_id")
  changedAt         DateTime        @default(now()) @map("changed_at")

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "lead_stage_transitions_workspace_fkey")
  conversation Conversation @relation(fields: [workspaceId, businessProfileId, conversationId], references: [workspaceId, businessProfileId, id], onDelete: Restrict, onUpdate: Restrict, map: "lead_stage_transitions_conversation_fkey")
  actor        User?        @relation("LeadStageActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "lead_stage_transitions_actor_fkey")

  @@index([workspaceId, businessProfileId, conversationId, changedAt(sort: Desc)], map: "lead_stage_transitions_history_idx")
  @@map("lead_stage_transitions")
}

/// What the business learned about a lead, one row per criterion per source — so the AI's reading and a
/// person's confirmation coexist rather than one silently replacing the other.
model LeadQualificationAnswer {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String          @map("workspace_id")
  businessProfileId String          @map("business_profile_id")
  conversationId    String          @map("conversation_id")
  criterion         String
  value             String
  source            LeadValueSource
  actorUserId       String?         @map("actor_user_id")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "lead_qualification_answers_workspace_fkey")
  conversation Conversation @relation(fields: [workspaceId, businessProfileId, conversationId], references: [workspaceId, businessProfileId, id], onDelete: Restrict, onUpdate: Restrict, map: "lead_qualification_answers_conversation_fkey")
  actor        User?        @relation("LeadQualificationActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "lead_qualification_answers_actor_fkey")

  @@unique([workspaceId, businessProfileId, conversationId, criterion, source], map: "lead_qualification_answers_criterion_key")
  @@map("lead_qualification_answers")
}

/// A phone number or an email address, belonging to one contact in one Business Profile (Issue #54).
model ContactPoint {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String                   @map("workspace_id")
  businessProfileId String                   @map("business_profile_id")
  contactId         String                   @map("contact_id")
  kind              ContactPointKind
  /// Normalized for comparison, so two spellings of one number are one contact point.
  normalizedValue   String                   @map("normalized_value")
  /// Exactly as the customer gave it, because that is what an operator recognises on screen.
  rawValue          String                   @map("raw_value")
  verification      ContactPointVerification @default(UNVERIFIED)
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  contact Contact @relation(fields: [workspaceId, businessProfileId, contactId], references: [workspaceId, businessProfileId, id], onDelete: Restrict, onUpdate: Restrict, map: "contact_points_contact_fkey")

  /// Scoped to the profile on purpose: the same number in another profile is another customer, and a
  /// unique index across profiles would be the cross-business identity graph this task avoids.
  @@unique([workspaceId, businessProfileId, kind, normalizedValue], map: "contact_points_value_key")
  @@index([workspaceId, businessProfileId, contactId], map: "contact_points_contact_idx")
  @@map("contact_points")
}

/// An id this customer has in a system outside the product: a booking tool, a CRM, a till.
model ExternalIdentity {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String   @map("workspace_id")
  businessProfileId String   @map("business_profile_id")
  contactId         String   @map("contact_id")
  system            String
  externalId        String   @map("external_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  contact Contact @relation(fields: [workspaceId, businessProfileId, contactId], references: [workspaceId, businessProfileId, id], onDelete: Restrict, onUpdate: Restrict, map: "external_identities_contact_fkey")

  @@unique([workspaceId, businessProfileId, system, externalId], map: "external_identities_value_key")
  @@map("external_identities")
}

/// A durable thing the business knows about a customer. A CHECK requires a confirming member for ACTIVE,
/// which is how "model output cannot become an authoritative customer fact" is enforced.
model CustomerFact {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String               @map("workspace_id")
  businessProfileId String               @map("business_profile_id")
  contactId         String               @map("contact_id")
  category          CustomerFactCategory
  subject           String
  value             String
  source            CustomerFactSource
  status            CustomerFactStatus   @default(SUGGESTED)
  sourceMessageId   String?              @map("source_message_id")
  sourceDraftId     String?              @map("source_draft_id")
  confirmedByUserId String?              @map("confirmed_by_user_id")
  confirmedAt       DateTime?            @map("confirmed_at")
  /// When this stops being true by itself. NULL means it does not expire on its own.
  expiresAt         DateTime?            @map("expires_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  contact       Contact  @relation(fields: [workspaceId, businessProfileId, contactId], references: [workspaceId, businessProfileId, id], onDelete: Restrict, onUpdate: Restrict, map: "customer_facts_contact_fkey")
  sourceMessage Message? @relation(fields: [workspaceId, businessProfileId, sourceMessageId], references: [workspaceId, businessProfileId, id], onDelete: Restrict, onUpdate: Restrict, map: "customer_facts_message_fkey")
  sourceDraft   AiDraft? @relation(fields: [workspaceId, businessProfileId, sourceDraftId], references: [workspaceId, businessProfileId, id], onDelete: Restrict, onUpdate: Restrict, map: "customer_facts_draft_fkey")
  confirmedBy   User?    @relation("CustomerFactConfirmer", fields: [confirmedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "customer_facts_confirmer_fkey")

  /// At most one ACTIVE entry per subject: memory that contradicted itself would be worse than none.
  @@unique([workspaceId, businessProfileId, contactId, category, subject], where: raw("status = 'ACTIVE'"), map: "customer_facts_active_subject_key")
  @@index([workspaceId, businessProfileId, contactId, status], map: "customer_facts_contact_idx")
  @@map("customer_facts")
}

/// What a customer would rather. Its own table because "prefers mornings" is not the same kind of claim
/// as "booked on the 4th", and merging them would let a preference be cited as evidence.
model CustomerPreference {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String             @map("workspace_id")
  businessProfileId String             @map("business_profile_id")
  contactId         String             @map("contact_id")
  subject           String
  value             String
  source            CustomerFactSource
  status            CustomerFactStatus @default(SUGGESTED)
  sourceMessageId   String?            @map("source_message_id")
  sourceDraftId     String?            @map("source_draft_id")
  confirmedByUserId String?            @map("confirmed_by_user_id")
  confirmedAt       DateTime?          @map("confirmed_at")
  expiresAt         DateTime?          @map("expires_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  contact     Contact @relation(fields: [workspaceId, businessProfileId, contactId], references: [workspaceId, businessProfileId, id], onDelete: Restrict, onUpdate: Restrict, map: "customer_preferences_contact_fkey")
  confirmedBy User?   @relation("CustomerPreferenceConfirmer", fields: [confirmedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "customer_preferences_confirmer_fkey")

  @@unique([workspaceId, businessProfileId, contactId, subject], where: raw("status = 'ACTIVE'"), map: "customer_preferences_active_subject_key")
  @@index([workspaceId, businessProfileId, contactId, status], map: "customer_preferences_contact_idx")
  @@map("customer_preferences")
}

/// A model's reading of one conversation. Assistive only, and it has no confirmation column at all —
/// there is nothing here for a person to make authoritative, which is the honest shape of that claim.
model ConversationSummary {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String    @map("workspace_id")
  businessProfileId String    @map("business_profile_id")
  conversationId    String    @map("conversation_id")
  summary           String
  modelProvider     String    @map("model_provider")
  modelName         String    @map("model_name")
  /// How far through the thread this reads, so a stale summary is recognisable rather than trusted.
  coversMessageId   String?   @map("covers_message_id")
  expiresAt         DateTime? @map("expires_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [workspaceId, businessProfileId, conversationId], references: [workspaceId, businessProfileId, id], onDelete: Restrict, onUpdate: Restrict, map: "conversation_summaries_conversation_fkey")

  @@unique([workspaceId, businessProfileId, conversationId], map: "conversation_summaries_conversation_key")
  @@map("conversation_summaries")
}

/// Two contacts that might be the same person. A suggestion, never a merge (Issue #54).
model DuplicateContactCandidate {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String    @map("workspace_id")
  businessProfileId String    @map("business_profile_id")
  /// Ordered by id, so one pair cannot become two rows facing each other. A CHECK insists.
  contactId         String    @map("contact_id")
  otherContactId    String    @map("other_contact_id")
  reason            String
  dismissedByUserId String?   @map("dismissed_by_user_id")
  dismissedAt       DateTime? @map("dismissed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  contact      Contact @relation("DuplicateCandidateContact", fields: [workspaceId, businessProfileId, contactId], references: [workspaceId, businessProfileId, id], onDelete: Restrict, onUpdate: Restrict, map: "duplicate_contact_candidates_contact_fkey")
  otherContact Contact @relation("DuplicateCandidateOther", fields: [workspaceId, businessProfileId, otherContactId], references: [workspaceId, businessProfileId, id], onDelete: Restrict, onUpdate: Restrict, map: "duplicate_contact_candidates_other_fkey")
  dismissedBy  User?   @relation("DuplicateCandidateDismisser", fields: [dismissedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "duplicate_contact_candidates_dismisser_fkey")

  @@unique([workspaceId, businessProfileId, contactId, otherContactId], map: "duplicate_contact_candidates_pair_key")
  @@map("duplicate_contact_candidates")
}

model Message {
  id                      String                 @id @default(uuid(7))
  workspaceId             String                 @map("workspace_id")
  businessProfileId       String                 @map("business_profile_id")
  channelAccountId        String                 @map("channel_account_id")
  conversationId          String                 @map("conversation_id")
  /// Platform message ID once known (inbound mid/wamid, or the ID returned by an accepted send).
  channelMessageId        String?                @map("channel_message_id")
  direction               MessageDirection
  source                  MessageSource
  kind                    MessageKind
  text                    String?
  media                   Json                   @default("[]")
  replyToChannelMessageId String?                @map("reply_to_channel_message_id")
  occurredAt              DateTime               @map("occurred_at")
  deliveryStatus          MessageDeliveryStatus? @map("delivery_status")
  deliveredAt             DateTime?              @map("delivered_at")
  readAt                  DateTime?              @map("read_at")
  transportPath           OutboundTransportPath? @map("transport_path")
  operationId             String?                @unique @map("operation_id")
  aiDraftId               String?                @map("ai_draft_id")
  sentByUserId            String?                @map("sent_by_user_id")
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")

  conversation   Conversation   @relation(fields: [workspaceId, businessProfileId, channelAccountId, conversationId], references: [workspaceId, businessProfileId, channelAccountId, id], onDelete: Restrict, onUpdate: Restrict)
  aiDraft        AiDraft?       @relation("DraftSend", fields: [workspaceId, businessProfileId, aiDraftId], references: [workspaceId, businessProfileId, id], onDelete: Restrict, onUpdate: Restrict)
  sentByUser     User?          @relation(fields: [sentByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  anchoredDrafts AiDraft[]      @relation("DraftAnchor")
  styleExamples  StyleExample[]

  customerFacts           CustomerFact[]

  followUpAnchors      FollowUp[]
  suppressionSources   FollowUpSuppression[]
  transcripts          MessageTranscript[]
  @@unique([workspaceId, businessProfileId, id])
  @@unique([workspaceId, businessProfileId, conversationId, id])
  @@unique([workspaceId, businessProfileId, channelAccountId, channelMessageId], map: "messages_channel_message_key")
  /// At most one outbound message per AI draft.
  @@unique([workspaceId, businessProfileId, aiDraftId], map: "messages_ai_draft_key")
  @@index([conversationId, occurredAt])
  @@map("messages")
}

// ---------------------------------------------------------------------------------------------------------
// AI drafts and delivery
// ---------------------------------------------------------------------------------------------------------

model AiDraft {
  id                 String        @id @default(uuid(7))
  workspaceId        String        @map("workspace_id")
  businessProfileId  String        @map("business_profile_id")
  conversationId     String        @map("conversation_id")
  anchorMessageId    String        @map("anchor_message_id")
  /// Conversation state_version the draft was generated for; the draft is stale once it moves on.
  anchorStateVersion Int           @map("anchor_state_version")
  /// Identity of one logical generation; a retried job reuses it instead of creating a second draft.
  generationKey      String        @map("generation_key")
  /// Whether automation or a person asked for this draft. Mode OFF permits only the latter, so the two
  /// must stay distinguishable in the audit trail (product-owner decision on PR #65).
  trigger            AiDraftTrigger @default(AUTOMATIC)
  /// The workspace member who asked; NULL for anything automation started (CHECK enforces the pairing).
  requestedByUserId  String?       @map("requested_by_user_id")
  /// Null only for a held generation whose output was unusable; the row still records what was attempted.
  text               String?
  structuredOutput   Json?         @map("structured_output")
  confidence         Float
  modelSuggestsSend  Boolean       @map("model_suggests_send")
  needsReview        Boolean       @map("needs_review")
  reasonCodes        String[]      @default([]) @map("reason_codes")
  intent             String?
  suggestedLeadStage LeadStage?    @map("suggested_lead_stage")
  suggestedAction    String?       @map("suggested_action")
  /// What the model said it relied on: always a subset of what retrieval supplied.
  factualSourceIds   String[]      @default([]) @map("factual_source_ids")
  /// What retrieval supplied and at what score, plus whether the corpus was reachable at all. Kept apart
  /// from `factual_source_ids` so a reviewer can tell "no such fact" from "we could not look" (RETRIEVAL.md).
  retrieval          Json?
  status             AiDraftStatus @default(PENDING)
  modelProvider      String        @map("model_provider")
  modelName          String        @map("model_name")
  promptVersion      String        @map("prompt_version")
  schemaVersion      String        @map("schema_version")
  providerRequestId  String?       @map("provider_request_id")
  latencyMs          Int?          @map("latency_ms")
  /// Normalized provider usage, for cost analysis. Cache columns exist so enabling prompt caching later
  /// cannot silently under-report input cost.
  inputTokens        Int?          @map("input_tokens")
  outputTokens       Int?          @map("output_tokens")
  cacheReadTokens    Int?          @map("cache_read_tokens")
  cacheWriteTokens   Int?          @map("cache_write_tokens")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  requestedByUser User?            @relation("DraftRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  conversation  Conversation       @relation(fields: [workspaceId, businessProfileId, conversationId], references: [workspaceId, businessProfileId, id], onDelete: Restrict, onUpdate: Restrict, map: "ai_drafts_conversation_fkey")
  anchorMessage Message            @relation("DraftAnchor", fields: [workspaceId, businessProfileId, conversationId, anchorMessageId], references: [workspaceId, businessProfileId, conversationId, id], onDelete: Restrict, onUpdate: Restrict, map: "ai_drafts_anchor_message_fkey")
  sentMessage   Message?           @relation("DraftSend")
  deliveryJob   DeliveryJobRecord?
  styleExamples StyleExample[]

  customerFacts     CustomerFact[]

  goalSuggestions      ConversationGoal[]
  taskSuggestions      HumanTask[]
  @@unique([workspaceId, businessProfileId, id])
  /// One draft per logical generation, so a retried job is idempotent.
  @@unique([workspaceId, businessProfileId, generationKey], map: "ai_drafts_generation_key")
  @@index([requestedByUserId], map: "ai_drafts_requested_by_user_id_idx")
  @@index([conversationId, createdAt])
  @@index([workspaceId, businessProfileId, status])
  @@map("ai_drafts")
}

model DeliveryJobRecord {
  id                String            @id @default(uuid(7))
  workspaceId       String            @map("workspace_id")
  businessProfileId String            @map("business_profile_id")
  /// Absent exactly when this delivery carries a person's own wording (ADR-018 Option B).
  draftId           String?           @map("draft_id")
  /// A person's own reply, for a conversation with no draft to approve. A CHECK admits exactly one origin.
  humanText         String?           @map("human_text")
  /// Set exactly when `humanText` is: a reply in somebody's words names its author.
  composedByUserId  String?           @map("composed_by_user_id")
  /// Present exactly when there is no draft to derive it from; the sender needs a recipient.
  conversationId    String?           @map("conversation_id")
  /// One logical outbound action; stable across queue retries (ADR-012).
  operationId       String            @unique @map("operation_id")
  correlationId     String            @map("correlation_id")
  status            DeliveryJobStatus @default(SCHEDULED)
  scheduledFor      DateTime          @map("scheduled_for")
  selectedDelayMs   Int               @map("selected_delay_ms")
  /// On whose authority this send may go out. Persisted with the delivery because the send happens later,
  /// in another process: an approval that lived only in the request that granted it would arrive there as
  /// automation, and the human-support transport path would be unreachable (ADR-014).
  authority         DeliveryAuthorityKind @default(AUTOMATED)
  /// Set exactly when `authority` is HUMAN_APPROVED: only an authenticated user action grants it.
  approvedByUserId  String?               @map("approved_by_user_id")
  approvedAt        DateTime?             @map("approved_at")
  /// Which send the person authorized: an ordinary reply, or the provider's human-support path.
  approvedReviewMode ReviewMode?          @map("approved_review_mode")
  /// Digest of the decision this delivery came from: who, which action, the final wording, the review mode
  /// and whether they asked to learn from it. A later request is the same decision only if it matches, so
  /// a replay can be answered with this operation and anything else cannot.
  decisionKey       String?               @map("decision_key")
  attemptCount      Int               @default(0) @map("attempt_count")
  claimedAt         DateTime?         @map("claimed_at")
  sentAt            DateTime?         @map("sent_at")
  cancelledAt       DateTime?         @map("cancelled_at")
  cancelReason      String?           @map("cancel_reason")
  platformMessageId String?           @map("platform_message_id")
  providerRequestId String?           @map("provider_request_id")
  lastErrorCode     String?           @map("last_error_code")
  lastErrorMessage  String?           @map("last_error_message")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  draft AiDraft? @relation(fields: [workspaceId, businessProfileId, draftId], references: [workspaceId, businessProfileId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Present exactly when this delivery carries a person's own wording (ADR-018 Option B).
  conversation Conversation? @relation(fields: [workspaceId, businessProfileId, conversationId], references: [workspaceId, businessProfileId, id], onDelete: Restrict, onUpdate: Restrict, map: "delivery_jobs_conversation_fkey")
  /// Present only while the outcome of this send is, or was, unknown (ADR-012).
  reconciliation DeliveryReconciliation?
  approvedByUser User? @relation(fields: [approvedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  composedByUser User? @relation("ComposedDeliveries", fields: [composedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "delivery_jobs_composed_by_fkey")

  /// One delivery job per draft, so a draft can never become more than one send.
  @@unique([workspaceId, businessProfileId, draftId], map: "delivery_jobs_draft_key")
  @@index([status, scheduledFor])
  @@index([workspaceId, businessProfileId, status])
  @@map("delivery_jobs")
}

// ---------------------------------------------------------------------------------------------------------
// Knowledge and style (separate retrieval domains, ADR-011): Workspace base + optional Business Profile
// override. Vector/full-text columns arrive with retrieval.
// ---------------------------------------------------------------------------------------------------------

model KnowledgeDocument {
  id                String                  @id @default(uuid(7))
  workspaceId       String                  @map("workspace_id")
  /// Absent for Workspace base knowledge; set for a Business Profile override/specific source.
  businessProfileId String?                 @map("business_profile_id")
  title             String
  sourceType        KnowledgeSourceType     @map("source_type")
  sourceUri         String?                 @map("source_uri")
  version           Int                     @default(1)
  /// The version retrieval answers with. Moved only by an explicit publish, never by Save, so editing a
  /// live source keeps serving the wording somebody approved (CHECK: ACTIVE requires one, and it can
  /// never name a version the document has not had).
  publishedVersion  Int?                    @map("published_version")
  status            KnowledgeDocumentStatus @default(DRAFT)
  contentHash       String?                 @map("content_hash")
  /// Whether the *current* version's content is searchable; every edit resets it to PENDING. A CHECK
  /// forbids an ACTIVE document whose failure is about the version it publishes — a failure in a saved
  /// but unpublished version is recorded without taking the published one out of retrieval.
  indexingState     KnowledgeIndexingState  @default(PENDING) @map("indexing_state")
  /// Set exactly when `indexingState` is FAILED (CHECK): an error with no failure reads as a current problem.
  indexingError     String?                 @map("indexing_error")
  indexedAt         DateTime?               @map("indexed_at")
  createdByUserId   String?                 @map("created_by_user_id")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  businessProfile BusinessProfile? @relation(fields: [workspaceId, businessProfileId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  createdByUser   User?            @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  chunks          KnowledgeChunk[]

  @@unique([workspaceId, id])
  @@index([workspaceId, businessProfileId, status])
  @@index([workspaceId, businessProfileId, status, updatedAt(sort: Desc)], map: "knowledge_documents_library_idx")
  @@map("knowledge_documents")
}

/// Chunks inherit their document's scope (Workspace base or Business Profile override) through document_id.
model KnowledgeChunk {
  id               String   @id @default(uuid(7))
  workspaceId      String   @map("workspace_id")
  documentId       String   @map("document_id")
  documentVersion  Int      @map("document_version")
  ordinal          Int
  content          String
  tokenCount       Int?     @map("token_count")
  /// Embedding profile/version; set exactly when `embedding` is set (CHECK), so vectors from two models
  /// can never be compared (ADR-011). Changing dimensions is a migration plus controlled re-embedding.
  embeddingProfile String?  @map("embedding_profile")
  /// pgvector column; read and written only through raw SQL in `src/retrieval`.
  embedding        Unsupported("vector(1024)")?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  document KnowledgeDocument @relation(fields: [workspaceId, documentId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([workspaceId, documentId, documentVersion, ordinal], map: "knowledge_chunks_position_key")
  @@index([workspaceId, documentId, documentVersion], map: "knowledge_chunks_scope_idx")
  @@map("knowledge_chunks")
}

/// How a business sounds: Workspace base when `business_profile_id` is NULL, a Business Profile override
/// when it is set (product-owner decision on PR #65). Customer-owned configuration, never platform config.
/// An operator's stop on automated outbound (RELIABILITY_INCIDENTS.md, Issue #56). Inbound is never
/// suspended: a switch that also dropped customer messages would turn a precaution into data loss.
model AutomationSuspension {
  id                String           @id @default(uuid(7))
  scope             SuspensionScope
  /// Absent for GLOBAL; present for every narrower scope, enforced by a CHECK.
  workspaceId       String?          @map("workspace_id")
  businessProfileId String?          @map("business_profile_id")
  channelAccountId  String?          @map("channel_account_id")
  reason            SuspensionReason
  /// Operator-written context. Never rendered to a customer and never a place for secrets.
  note              String?
  since             DateTime
  /// Absent means it stays until a person lifts it, which is the safe default for a precaution.
  until             DateTime?
  /// Who pulled the switch; absent when the system did it in response to a dependency.
  byUserId          String?          @map("by_user_id")
  /// When and by whom it was lifted. Kept rather than deleted: the question after an incident is always
  /// who turned this off and whether anyone turned it back on.
  liftedAt          DateTime?        @map("lifted_at")
  liftedByUserId    String?          @map("lifted_by_user_id")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  byUser     User? @relation("SuspensionBy", fields: [byUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  liftedByUser User? @relation("SuspensionLiftedBy", fields: [liftedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([scope, liftedAt])
  @@index([workspaceId, businessProfileId, liftedAt])
  @@map("automation_suspensions")
}

/// One unresolved outbound operation (ADR-012, Issue #56).
///
/// The row exists so that an ambiguous send survives the queue: a Redis flush or a dropped job must not
/// be able to make "we do not know whether the customer received this" disappear. It is written before
/// anything is examined, and it keeps every attempt's conclusion rather than only the last one's state.
model DeliveryReconciliation {
  id                String               @id @default(uuid(7))
  workspaceId       String               @map("workspace_id")
  businessProfileId String               @map("business_profile_id")
  /// One logical outbound action, the same identity the delivery job carries (ADR-012).
  operationId       String               @unique @map("operation_id")
  deliveryJobId     String               @map("delivery_job_id")
  conversationId    String               @map("conversation_id")
  reason            ReconciliationReason
  state             ReconciliationState  @default(PENDING)
  attemptCount      Int                  @default(0) @map("attempt_count")
  /// When the ambiguity was first observed; the grace period before a person is told runs from here.
  detectedAt        DateTime             @map("detected_at")
  lastAttemptAt     DateTime?            @map("last_attempt_at")
  /// Set together with a terminal state, never on its own (CHECK).
  resolvedAt        DateTime?            @map("resolved_at")
  /// One short phrase saying how it was concluded. Never a provider response body, never a secret.
  evidence          String?
  providerRequestId String?              @map("provider_request_id")
  providerCode      String?              @map("provider_code")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  /// Keyed on the operation rather than on a row id, so the record and the job it investigates cannot
  /// drift apart, and so a job with no record at all is a question the database can answer directly.
  deliveryJob DeliveryJobRecord @relation(fields: [operationId], references: [operationId], onDelete: Restrict, onUpdate: Restrict)

  @@index([state, detectedAt])
  @@index([workspaceId, businessProfileId, state])
  @@map("delivery_reconciliations")
}

model StyleProfile {
  id                String        @id @default(uuid(7))
  workspaceId       String        @map("workspace_id")
  /// Absent for the Workspace base voice; set for one Business Profile's override of it.
  businessProfileId String?       @map("business_profile_id")
  /// Trusted business instructions. Never customer text, and never a source of facts.
  persona           String?
  tone              String?
  replyLength       ReplyLength?  @map("reply_length")
  emoji             EmojiUsage?
  greeting          String?
  signOff           String?       @map("sign_off")
  preferredPhrases  String[]      @default([]) @map("preferred_phrases")
  avoidedPhrases    String[]      @default([]) @map("avoided_phrases")
  /// BCP-47 tag; NULL means the business has no fixed language.
  language          String?
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  businessProfile BusinessProfile? @relation(fields: [workspaceId, businessProfileId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict, map: "style_profiles_business_profile_fkey")

  /// One base voice per Workspace and one override per Business Profile. Partial, because in a plain
  /// unique index a NULL never equals another NULL, so a Workspace could accumulate any number of "base"
  /// rows and the resolution order would stop being defined.
  @@unique([workspaceId], where: raw("business_profile_id IS NULL"), map: "style_profiles_workspace_base_key")
  @@unique([workspaceId, businessProfileId], where: raw("business_profile_id IS NOT NULL"), map: "style_profiles_business_profile_key")
  @@map("style_profiles")
}

model StyleExample {
  id                String                 @id @default(uuid(7))
  workspaceId       String                 @map("workspace_id")
  /// Absent for Workspace base style; required when the example comes from a Business Profile conversation.
  businessProfileId String?                @map("business_profile_id")
  inboundContext    String                 @map("inbound_context")
  outboundText      String                 @map("outbound_text")
  provenance        StyleExampleProvenance
  sourceMessageId   String?                @map("source_message_id")
  sourceDraftId     String?                @map("source_draft_id")
  /// The first person to vouch for this example. Set once and never replaced: re-stamping it on every
  /// restore destroyed the identity of whoever originally approved it.
  approvedByUserId  String?                @map("approved_by_user_id")
  status            StyleExampleStatus     @default(ACTIVE)
  /// The most recent lifecycle decision, and who made it. The status alone cannot say who withdrew an
  /// example, and one rejected, restored and archived again looks identical to one archived on day one.
  decision          StyleDecision?
  decidedByUserId   String?                @map("decided_by_user_id")
  decidedAt         DateTime?              @map("decided_at")
  /// BCP-47 tag of the example's language. NULL means language-agnostic: such an example is a fallback
  /// that matches any language rather than a wrong-language match (product-owner decision on PR #66).
  language          String?
  /// Set exactly when `embedding` is set (CHECK), as for knowledge chunks.
  embeddingProfile  String?                @map("embedding_profile")
  /// pgvector column; read and written only through raw SQL in `src/retrieval`.
  embedding         Unsupported("vector(1024)")?
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  businessProfile BusinessProfile? @relation(fields: [workspaceId, businessProfileId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  sourceMessage   Message?         @relation(fields: [workspaceId, businessProfileId, sourceMessageId], references: [workspaceId, businessProfileId, id], onDelete: Restrict, onUpdate: Restrict)
  sourceDraft     AiDraft?         @relation(fields: [workspaceId, businessProfileId, sourceDraftId], references: [workspaceId, businessProfileId, id], onDelete: Restrict, onUpdate: Restrict)
  approvedByUser  User?            @relation(fields: [approvedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  decidedBy       User?            @relation("StyleExampleDecider", fields: [decidedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "style_examples_decider_fkey")
  decisions       StyleExampleDecision[]

  @@index([workspaceId, businessProfileId, status])
  @@index([workspaceId, businessProfileId, language], map: "style_examples_language_idx")
  @@index([workspaceId, businessProfileId, status, createdAt(sort: Desc)], map: "style_examples_suggested_idx")
  @@index([workspaceId, businessProfileId, decidedAt(sort: Desc)], map: "style_examples_decided_idx")
  @@map("style_examples")
}

/// Every decision anybody ever made about a style example (#32).
///
/// The columns on the example itself answer "who withdrew this?"; they cannot answer "what happened to
/// it?", because each decision overwrites the last. An example rejected, restored and archived again is a
/// different thing from one archived on the first day, and the Style screen is asked to tell them apart.
///
/// Append-only by use rather than by trigger: nothing in this package updates or deletes a row here.
model StyleExampleDecision {
  id             String        @id @default(uuid(7))
  workspaceId    String        @map("workspace_id")
  styleExampleId String        @map("style_example_id")
  decision       StyleDecision
  /// Never null, unlike the example's own column: a decision nobody made is not a decision.
  decidedByUserId String       @map("decided_by_user_id")
  decidedAt      DateTime      @default(now()) @map("decided_at")

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  styleExample StyleExample @relation(fields: [styleExampleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  decidedBy    User         @relation(fields: [decidedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([workspaceId, styleExampleId, decidedAt])
  @@map("style_example_decisions")
}

// ---------------------------------------------------------------------------------------------------------
// Automation policy: Business Profile default + optional channel-account override (DATA_MODEL.md v0.4 §15)
// ---------------------------------------------------------------------------------------------------------

model AutomationPolicy {
  id                                  String                     @id @default(uuid(7))
  workspaceId                         String                     @map("workspace_id")
  businessProfileId                   String                     @map("business_profile_id")
  /// Absent for the Business Profile default; set for a channel-account override in the same profile.
  channelAccountId                    String?                    @map("channel_account_id")
  mode                                AiMode                     @default(OFF)
  /// What this assistant is for, in the owner's words. Not how it sounds — that is the StyleProfile's.
  businessGoal                        String?                    @map("business_goal")
  /// When a lead is worth booking, as sentences a person wrote. A CHECK forbids an empty one.
  qualificationCriteria               String[]                   @default([]) @map("qualification_criteria")
  confidenceThreshold                 Float                      @default(0.8) @map("confidence_threshold")
  mandatoryReviewReasons              String[]                   @map("mandatory_review_reasons")
  debounceMinMs                       Int                        @default(7000) @map("debounce_min_ms")
  debounceMaxMs                       Int                        @default(12000) @map("debounce_max_ms")
  deliveryDelayMinMs                  Int                        @default(30000) @map("delivery_delay_min_ms")
  deliveryDelayMaxMs                  Int                        @default(120000) @map("delivery_delay_max_ms")
  quietHoursTimeZone                  String?                    @map("quiet_hours_time_zone")
  quietHoursStart                     String?                    @map("quiet_hours_start")
  quietHoursEnd                       String?                    @map("quiet_hours_end")
  takeoverPauseMs                     Int                        @default(21600000) @map("takeover_pause_ms")
  /// Whether the product signals that a customer's message was seen, and that a reply is being written.
  /// OFF by default: presence is a promise to a customer, and a business opts into making it.
  presenceMode                        PresenceMode               @default(OFF) @map("presence_mode")
  /// How long before the reply the typing indicator is raised. Bounded by the provider's own indicator
  /// lifetime, which is 25 s on WhatsApp — a longer lead would show it and drop it.
  presenceTypingLeadMs                Int                        @default(8000) @map("presence_typing_lead_ms")
  instagramAfterWindowPolicy          InstagramAfterWindowPolicy @default(STANDARD_ONLY) @map("instagram_after_window_policy")
  whatsappAfterWindowPolicy           WhatsAppAfterWindowPolicy  @default(SERVICE_WINDOW_ONLY) @map("whatsapp_after_window_policy")
  whatsappTemplateAutomationAllowlist String[]                   @default([]) @map("whatsapp_template_automation_allowlist")
  createdAt                           DateTime                   @default(now()) @map("created_at")
  updatedAt                           DateTime                   @updatedAt @map("updated_at")

  businessProfile BusinessProfile @relation(fields: [workspaceId, businessProfileId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  channelAccount  ChannelAccount? @relation(fields: [workspaceId, businessProfileId, channelAccountId], references: [workspaceId, businessProfileId, id], onDelete: Restrict, onUpdate: Restrict)

  /// One Business Profile default (channel_account_id IS NULL) per profile.
  @@unique([workspaceId, businessProfileId], where: raw("channel_account_id IS NULL"), map: "automation_policies_profile_default_key")
  @@unique([workspaceId, businessProfileId, channelAccountId], map: "automation_policies_channel_override_key")
  @@map("automation_policies")
}

/// Who changed the automation rules, when, and the values on both sides (AI_CONFIGURATION_UX.md, #30).
///
/// Every change that altered a stored value, with the computed impacts alongside — so "material" is a
/// predicate over `impacts` rather than a judgement made at write time and impossible to revisit.
model PolicyChangeAudit {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String   @map("workspace_id")
  businessProfileId String   @map("business_profile_id")
  /// Absent when the Business Profile default was edited; set for a channel-account override.
  channelAccountId  String?  @map("channel_account_id")
  /// A policy change is always somebody's; there is no system path that edits these settings.
  actorUserId       String   @map("actor_user_id")
  changedAt         DateTime @default(now()) @map("changed_at")
  impacts           String[] @default([])
  before            Json
  after             Json

  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  businessProfile BusinessProfile @relation(fields: [workspaceId, businessProfileId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict, map: "policy_change_audits_business_profile_fkey")
  actor           User            @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "policy_change_audits_actor_fkey")

  @@index([workspaceId, businessProfileId, changedAt(sort: Desc)], map: "policy_change_audits_history_idx")
  @@map("policy_change_audits")
}

// ---------------------------------------------------------------------------------------------------------
// Audit (P5-08): a searchable, append-only record of the material things people do.
// ---------------------------------------------------------------------------------------------------------

model AuditEvent {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String         @map("workspace_id")
  /// Absent for a workspace-level action: a membership or role change belongs to nobody's Business Profile.
  businessProfileId String?  @map("business_profile_id")
  kind        AuditEventKind
  actorKind   AuditActorKind @map("actor_kind")
  /// Set exactly when `actorKind` is USER; a CHECK holds both halves.
  actorUserId String?        @map("actor_user_id")
  occurredAt  DateTime       @default(now()) @map("occurred_at")
  /// What the action was about, in words, for the search box — written by the caller, because the person
  /// searching remembers what they did and not our JSON shape.
  summary     String
  /// The thing acted on. Deliberately not a foreign key: an audit row must outlive what it describes.
  subjectType String         @map("subject_type")
  subjectId   String         @map("subject_id")
  /// Denormalized filters, so an audit search never joins the customer data it is auditing.
  channelAccountId String?   @map("channel_account_id")
  conversationId   String?   @map("conversation_id")
  /// Whether reading this row needs an admin.
  sensitive   Boolean        @default(false)
  detail      Json           @default("{}")
  createdAt   DateTime       @default(now()) @map("created_at")

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  businessProfile BusinessProfile? @relation(fields: [workspaceId, businessProfileId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict, map: "audit_events_business_profile_fkey")
  actor           User?            @relation(fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "audit_events_actor_fkey")

  @@index([workspaceId, occurredAt(sort: Desc)], map: "audit_events_history_idx")
  @@index([workspaceId, businessProfileId, occurredAt(sort: Desc)], map: "audit_events_profile_idx")
  @@index([workspaceId, kind, occurredAt(sort: Desc)], map: "audit_events_kind_idx")
  @@index([workspaceId, channelAccountId, occurredAt(sort: Desc)], map: "audit_events_channel_idx")
  @@index([workspaceId, conversationId, occurredAt(sort: Desc)], map: "audit_events_conversation_idx")
  @@map("audit_events")
}

// Goals, follow-ups and human tasks (P3-02): bounded goal execution, with the bounds in the database.
// ---------------------------------------------------------------------------------------------------------

model ConversationGoal {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String               @map("workspace_id")
  businessProfileId String               @map("business_profile_id")
  conversationId    String               @map("conversation_id")
  kind              ConversationGoalKind
  /// One active primary per conversation, which a partial unique index enforces: two would be two answers
  /// to "what are we trying to do here".
  isPrimary         Boolean              @map("is_primary")
  status            GoalStatus           @default(ACTIVE)
  source            GoalSource
  /// Set exactly when a person decided; a CHECK holds the pair with `sourceDraftId`.
  setByUserId       String?              @map("set_by_user_id")
  sourceDraftId     String?              @map("source_draft_id")
  note              String?
  achievedAt        DateTime?            @map("achieved_at")
  abandonedAt       DateTime?            @map("abandoned_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  conversation Conversation @relation(fields: [workspaceId, businessProfileId, conversationId], references: [workspaceId, businessProfileId, id], onDelete: Restrict, onUpdate: Restrict, map: "conversation_goals_conversation_fkey")
  setByUser    User?        @relation(fields: [setByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "conversation_goals_actor_fkey")
  sourceDraft  AiDraft?     @relation(fields: [workspaceId, businessProfileId, sourceDraftId], references: [workspaceId, businessProfileId, id], onDelete: Restrict, onUpdate: Restrict, map: "conversation_goals_draft_fkey")
  followUps    FollowUp[]

  /// One active primary goal per conversation. Partial, because history must stay: a conversation that
  /// achieved one goal and then took another has two rows and only one of them is current.
  @@unique([workspaceId, businessProfileId, conversationId], where: raw("status = 'ACTIVE' AND is_primary"), map: "conversation_goals_active_primary_key")
  @@index([workspaceId, businessProfileId, conversationId, createdAt(sort: Desc)], map: "conversation_goals_history_idx")
  @@map("conversation_goals")
}

model FollowUp {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String              @map("workspace_id")
  businessProfileId   String              @map("business_profile_id")
  conversationId      String              @map("conversation_id")
  /// Required: a follow-up with no goal is chasing somebody for no stated reason.
  goalId              String              @map("goal_id") @db.Uuid
  status              FollowUpStatus      @default(PENDING)
  dueAt               DateTime            @map("due_at")
  /// The state this was planned against, revalidated at execution.
  anchorMessageId     String              @map("anchor_message_id")
  anchorStateVersion  Int                 @map("anchor_state_version")
  attemptCount        Int                 @default(0) @map("attempt_count")
  /// Bounded in the database: 1 to 5, and `attemptCount` never above it.
  maxAttempts         Int                 @default(3) @map("max_attempts")
  /// The Business Profile's own sending window, half-open and never zero-width.
  daypartTimeZone     String              @map("daypart_time_zone")
  daypartStartHour    Int                 @map("daypart_start_hour")
  daypartEndHour      Int                 @map("daypart_end_hour")
  stopReason          FollowUpStopReason? @map("stop_reason")
  createdByUserId     String?             @map("created_by_user_id")
  /// Set when an attempt reached the shared coordinator, so a follow-up and its send can be joined.
  deliveryOperationId String?             @map("delivery_operation_id")
  lastAttemptAt       DateTime?           @map("last_attempt_at")
  settledAt           DateTime?           @map("settled_at")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  conversation Conversation     @relation(fields: [workspaceId, businessProfileId, conversationId], references: [workspaceId, businessProfileId, id], onDelete: Restrict, onUpdate: Restrict, map: "follow_ups_conversation_fkey")
  goal         ConversationGoal @relation(fields: [goalId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "follow_ups_goal_fkey")
  anchor       Message          @relation(fields: [workspaceId, businessProfileId, anchorMessageId], references: [workspaceId, businessProfileId, id], onDelete: Restrict, onUpdate: Restrict, map: "follow_ups_anchor_fkey")
  createdBy    User?            @relation(fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "follow_ups_creator_fkey")

  /// The duplicate-job guard. An index rather than a check in code, because the race it prevents is two
  /// workers planning a follow-up at the same moment: whichever commits second is refused by the database,
  /// which is the only place that can see both.
  @@unique([workspaceId, businessProfileId, conversationId], where: raw("status = 'PENDING'"), map: "follow_ups_pending_conversation_key")
  @@index([status, dueAt], map: "follow_ups_due_idx")
  @@index([workspaceId, businessProfileId, status, dueAt], map: "follow_ups_profile_idx")
  @@map("follow_ups")
}

/// Work for a person.
///
/// Note what is absent: no draft to send, no operation id, no delivery relation. That is the mechanism by
/// which completing a task can never message a customer — there is nothing here for a send path to hold.
model HumanTask {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String          @map("workspace_id")
  businessProfileId String          @map("business_profile_id")
  /// Absent for a task about the business rather than one conversation.
  conversationId    String?         @map("conversation_id")
  kind              HumanTaskKind
  status            HumanTaskStatus @default(OPEN)
  title             String
  detail            String?
  dueAt             DateTime?       @map("due_at")
  assignedUserId    String?         @map("assigned_user_id")
  createdByUserId   String?         @map("created_by_user_id")
  /// A model may raise a task, which is safe precisely because a task cannot send anything.
  sourceDraftId     String?         @map("source_draft_id")
  completedByUserId String?         @map("completed_by_user_id")
  completedAt       DateTime?       @map("completed_at")
  dismissedReason   String?         @map("dismissed_reason")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  businessProfile BusinessProfile @relation(fields: [workspaceId, businessProfileId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict, map: "human_tasks_business_profile_fkey")
  conversation    Conversation?   @relation(fields: [workspaceId, businessProfileId, conversationId], references: [workspaceId, businessProfileId, id], onDelete: Restrict, onUpdate: Restrict, map: "human_tasks_conversation_fkey")
  assignedUser    User?           @relation("HumanTaskAssignee", fields: [assignedUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "human_tasks_assignee_fkey")
  createdByUser   User?           @relation("HumanTaskCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "human_tasks_creator_fkey")
  completedByUser User?           @relation("HumanTaskCompleter", fields: [completedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "human_tasks_completer_fkey")
  sourceDraft     AiDraft?        @relation(fields: [workspaceId, businessProfileId, sourceDraftId], references: [workspaceId, businessProfileId, id], onDelete: Restrict, onUpdate: Restrict, map: "human_tasks_draft_fkey")

  @@index([workspaceId, businessProfileId, status, dueAt], map: "human_tasks_queue_idx")
  @@index([workspaceId, businessProfileId, assignedUserId, status], map: "human_tasks_assignee_idx")
  @@map("human_tasks")
}

/// A customer who asked not to be chased. Its own table because it is a claim with provenance.
model FollowUpSuppression {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String    @map("workspace_id")
  businessProfileId String    @map("business_profile_id")
  contactId         String    @map("contact_id")
  reason            String
  recordedByUserId  String?   @map("recorded_by_user_id")
  sourceMessageId   String?   @map("source_message_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  /// Only a person lifts an opt-out. Nothing expires on its own.
  liftedAt          DateTime? @map("lifted_at")
  liftedByUserId    String?   @map("lifted_by_user_id")

  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  contact       Contact   @relation(fields: [workspaceId, businessProfileId, contactId], references: [workspaceId, businessProfileId, id], onDelete: Restrict, onUpdate: Restrict, map: "followup_suppressions_contact_fkey")
  recordedBy    User?     @relation("SuppressionRecorder", fields: [recordedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "followup_suppressions_recorder_fkey")
  liftedBy      User?     @relation("SuppressionLifter", fields: [liftedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "followup_suppressions_lifter_fkey")
  sourceMessage Message?  @relation(fields: [workspaceId, businessProfileId, sourceMessageId], references: [workspaceId, businessProfileId, id], onDelete: Restrict, onUpdate: Restrict, map: "followup_suppressions_message_fkey")

  /// One live suppression per customer per profile, so "are they opted out" is one row and not a count.
  @@unique([workspaceId, businessProfileId, contactId], where: raw("lifted_at IS NULL"), map: "followup_suppressions_live_key")
  @@map("followup_suppressions")
}

// ---------------------------------------------------------------------------------------------------------
// Transactional outbox (P1-05): queue work committed atomically with the state that requires it.
// ---------------------------------------------------------------------------------------------------------

model QueueOutbox {
  id                String     @id @default(uuid(7))
  workspaceId       String     @map("workspace_id")
  /// Queue work is Business Profile scoped like the customer data it acts on (Issue #53).
  businessProfileId String     @map("business_profile_id")
  kind              OutboxKind
  /// Logical work identity (e.g. one debounce per stored inbound message); duplicates are not added.
  dedupeKey         String     @unique @map("dedupe_key")
  correlationId     String     @map("correlation_id")
  payload           Json
  /// Selected delay, counted from created_at, applied when the job is enqueued.
  delayMs           Int        @map("delay_ms")
  /// Earliest time the next dispatch attempt may run.
  availableAt       DateTime   @default(now()) @map("available_at")
  /// Dispatcher lease; an expired lease makes the entry claimable again.
  lockedUntil       DateTime?  @map("locked_until")
  attempts          Int        @default(0)
  lastErrorName     String?    @map("last_error_name")
  dispatchedAt      DateTime?  @map("dispatched_at")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  businessProfile BusinessProfile @relation(fields: [workspaceId, businessProfileId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([availableAt], where: raw("dispatched_at IS NULL"), map: "queue_outbox_pending_idx")
  @@map("queue_outbox")
}

/**
 * WhatsApp's own provider assets for one connected number (Issue #19, ADR-015, WHATSAPP_ONBOARDING.md).
 *
 * A separate table rather than columns on `channel_accounts`, because none of this is channel-neutral:
 * Instagram has no messaging account, no business portfolio and no two-step verification. The neutral row
 * keeps the sending asset as its `external_account_id`; everything Meta-shaped lives here, which is what
 * lets Meta's account model keep moving without touching contact or conversation identity.
 *
 * `waba_id` is the **messaging account** ID. Meta is splitting the WhatsApp Business Account into a
 * WhatsApp Account for numbers and identity and a Messaging Account for templates, billing and webhook
 * subscriptions; existing `waba_id` values keep working and now denote the latter (re-verified
 * 2026-10-04). The business portfolio is a third identifier and is not derivable from either.
 */
model WhatsAppConnection {
  id                String                 @id @default(uuid(7))
  workspaceId       String                 @map("workspace_id")
  businessProfileId String                 @map("business_profile_id")
  channelAccountId  String                 @map("channel_account_id")
  /// Messaging account: owns the webhook subscription and the template catalogue.
  wabaId            String                 @map("waba_id")
  businessPortfolioId String?              @map("business_portfolio_id")
  /// Human-readable only. Never an identity: a payload can claim any display number it likes.
  displayPhoneNumber String?               @map("display_phone_number")
  verifiedName      String?                @map("verified_name")
  qualityRating     String?                @map("quality_rating")
  codeVerificationStatus String?           @map("code_verification_status")
  platformType      String?                @map("platform_type")
  onboardingMode    WhatsAppOnboardingMode @default(UNKNOWN) @map("onboarding_mode")
  /// Set when Meta confirmed `{"success": true}` for `POST /<WABA_ID>/subscribed_apps`.
  webhookSubscribedAt DateTime?            @map("webhook_subscribed_at")
  /// Set when Meta confirmed the Cloud API registration of the number with its two-step PIN.
  phoneRegisteredAt DateTime?              @map("phone_registered_at")
  templatesSyncedAt DateTime?              @map("templates_synced_at")
  /// False when the bootstrap stopped at its page bound, so the catalogue is known to be partial.
  templatesComplete Boolean?               @map("templates_complete")
  /// Set in the same transaction that marks the account connected; the CHECKs below hang off it.
  connectedAt       DateTime?              @map("connected_at")
  /// Fixed reason code for the account's current health. Never provider prose.
  healthReason      String?                @map("health_reason")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  businessProfile BusinessProfile @relation(fields: [workspaceId, businessProfileId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  channelAccount  ChannelAccount  @relation(fields: [workspaceId, businessProfileId, channelAccountId], references: [workspaceId, businessProfileId, id], onDelete: Restrict, onUpdate: Restrict)
  templates       WhatsAppMessageTemplate[]

  /// One connection per account, which is what makes the relation above one-to-one.
  @@unique([workspaceId, businessProfileId, channelAccountId])
  @@unique([workspaceId, channelAccountId])
  @@unique([workspaceId, id])
  @@index([wabaId])
  @@map("whatsapp_connections")
}

/**
 * The approved/pending/rejected template catalogue for one connection.
 *
 * Meta identifies a template by name **and** language, so that pair is unique here too: a send names both,
 * and a catalogue that allowed two rows for one pair would let a delivery match the wrong one. The
 * provider ID is unique as well, so a rename is an update rather than a duplicate.
 *
 * `synced_at` exists because a cached template is never eligible forever (WHATSAPP_ADAPTER.md): delivery
 * policy rechecks current-enough status, and it needs to know how old this row is to do that.
 */
model WhatsAppMessageTemplate {
  id                 String   @id @default(uuid(7))
  workspaceId        String   @map("workspace_id")
  connectionId       String   @map("connection_id")
  providerTemplateId String   @map("provider_template_id")
  name               String
  language           String
  category           String?
  status             String
  /// Provider JSON, kept as sent: the catalogue is an audit record and re-modelling it would lose detail.
  components         Json?
  /// `POSITIONAL` or `NAMED`. The provider's two parameter formats serialize differently and a send in the
  /// wrong one is refused, so the format is stored rather than guessed at dispatch (Issue #20).
  parameterFormat    String   @default("POSITIONAL") @map("parameter_format")
  /// The placeholders the approved wording carries, parsed once at sync: `["1","2"]`, or the names.
  parameters         String[] @default([])
  syncedAt           DateTime @map("synced_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  connection WhatsAppConnection @relation(fields: [workspaceId, connectionId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([workspaceId, connectionId, providerTemplateId])
  @@unique([workspaceId, connectionId, name, language])
  @@index([workspaceId, connectionId, status])
  @@map("whatsapp_message_templates")
}

/**
 * A machine's reading of one recording a customer sent (Issue #21).
 *
 * A table of its own, and never a column on `messages`, because a transcript is a *claim about* the
 * message rather than part of it. The raw media reference stays where it was — in the message's own
 * `media` array — and everything about who read it, with what, how long it took and whether it worked
 * lives here. That separation is what lets a reading be retried, superseded or deleted without touching
 * the customer's message, and what lets an audit say which model produced the words a reply was drafted
 * against.
 *
 * `confidence` is nullable and is expected to be null: the recommended transcription model publishes no
 * confidence of any kind. A CHECK forbids a number without a `confidence_source`, so a figure can never
 * sit here unattributed — the point is that "we do not know how sure it was" stays visible instead of
 * becoming an invented 1.0.
 *
 * Like `ConversationSummary`, this is assistive and has no confirmation column. There is nothing here for
 * a person to make authoritative: the recording is the authority, and this is one reading of it.
 */
model MessageTranscript {
  id                String             @id @default(uuid(7))
  workspaceId       String             @map("workspace_id")
  businessProfileId String             @map("business_profile_id")
  messageId         String             @map("message_id")
  /// The provider's own media object. Kept so a deletion request can name it at the provider's end.
  providerMediaId   String             @map("provider_media_id")
  mimeType          String?            @map("mime_type")
  sizeBytes         Int?               @map("size_bytes")
  state             TranscriptionState @default(PENDING)
  /// The words, when there are any. Null while pending and null whenever the reading failed.
  text              String?
  /// ISO-639-1 as the provider detected it. Null when it could not tell, which is a real answer.
  language          String?
  provider          String?
  /// The model the provider says actually ran, not the alias that was requested.
  model             String?
  /// The provider's own revision marker for that model, when it publishes one.
  modelRevision     String?            @map("model_revision")
  confidence        Float?
  /// `PROVIDER` or `DERIVED`. Set exactly when `confidence` is, so no number is unattributed.
  confidenceSource  String?            @map("confidence_source")
  durationSeconds   Float?             @map("duration_seconds")
  providerRequestId String?            @map("provider_request_id")
  latencyMs         Int?               @map("latency_ms")
  /// This codebase's own failure vocabulary. Never the provider's prose, which can quote the recording.
  failureReason     String?            @map("failure_reason")
  /// The provider's own code, for the audit trail.
  failureCode       String?            @map("failure_code")
  attemptCount      Int                @default(0) @map("attempt_count")
  requestedAt       DateTime           @default(now()) @map("requested_at")
  completedAt       DateTime?          @map("completed_at")
  /// Set when the raw media was deleted at the provider's end, which is the retention hook's record.
  mediaDeletedAt    DateTime?          @map("media_deleted_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  message Message @relation(fields: [workspaceId, businessProfileId, messageId], references: [workspaceId, businessProfileId, id], onDelete: Restrict, onUpdate: Restrict)

  /// One reading per media object per message: a retry updates the row rather than adding a second claim.
  @@unique([workspaceId, messageId, providerMediaId])
  @@unique([workspaceId, id])
  @@index([workspaceId, state])
  @@map("message_transcripts")
}

/// An internal role, from `ADMIN_OPERATIONS.md` (#59).
///
/// Deliberately not `WorkspaceRole`. A customer's OWNER runs their own business; a platform SUPPORT
/// engineer runs ours, and neither grants anything in the other's world. Keeping them in two enums is
/// what makes a mistaken assignment a type error rather than a privilege.
enum PlatformRole {
  SUPPORT
  BILLING
  OPERATIONS
  PLATFORM_ADMIN
}

/// How serious an operator action is (#59). Derived from the kind, never passed in.
enum PlatformAuditSeverity {
  INFO
  WARNING
  CRITICAL
}

/// What the internal audit records (#59, ADMIN_OPERATIONS.md). Operator actions only.
enum PlatformAuditKind {
  PLATFORM_MEMBER_CHANGED
  WORKSPACE_INSPECTED
  SUPPORT_SESSION_OPENED
  SUPPORT_SESSION_REVOKED
  BREAK_GLASS_OPENED
  CUSTOMER_CONTENT_READ
  KILL_SWITCH_PULLED
  KILL_SWITCH_LIFTED
  RECONCILIATION_REQUESTED
  RELEASE_RECORDED
  RELEASE_REVIEW_RECORDED
  ROLLOUT_ALLOWLIST_CHANGED
}

/// A member of staff, with an internal role (#59).
///
/// Separate from `WorkspaceMember` and it has to be: a staff row in `workspace_members` would appear in
/// that user's workspace list and in the workspace's seat count, so internal access would consume a
/// customer's paid seat and be visible to them as a member they never invited.
///
/// One role per person, not a set. A person who needs two jobs' permissions is a question for the owner,
/// not a row somebody adds quietly — and `PLATFORM_ADMIN` is deliberately not a superset.
model PlatformMember {
  id        String       @id @default(uuid(7))
  userId    String       @unique @map("user_id")
  role      PlatformRole
  /// Why this person has this role: a team, a rota, a ticket. Required, like an override's reason.
  note      String
  /// Set when access was withdrawn. The row stays, because audit rows point at it.
  revokedAt DateTime?    @map("revoked_at")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user              User                  @relation("PlatformMemberUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  supportSessions   SupportAccessSession[] @relation("SupportSessionActor")
  revokedSessions   SupportAccessSession[] @relation("SupportSessionRevoker")
  auditEvents       PlatformAuditEvent[]

  @@index([role, revokedAt])
  @@map("platform_members")
}

/// An explicit, scoped, time-limited grant of access to one customer's data (#59, ADMIN_OPERATIONS.md).
///
/// Metadata needs no session: an operator sees identifiers, capability state and operational health
/// without one. This exists for the step beyond that — reading somebody's correspondence — which the spec
/// requires to be explicit, scoped, time-bounded and audited.
///
/// Expiry is *derived* at every read rather than enforced by a sweeper, so there is no window in which a
/// lapsed row still reads as live. `supportScopeOf` in the domain is the only thing that decides.
model SupportAccessSession {
  id                 String   @id @default(uuid(7))
  /// The staff member, through `platform_members` rather than `users`: a session can only belong to
  /// somebody who held a platform role, and the role in force is recorded beside it.
  platformMemberId   String   @map("platform_member_id")
  /// The role at the moment it was opened. Kept, because a role can change and this row must not.
  actorRole          PlatformRole @map("actor_role")
  workspaceId        String   @map("workspace_id")
  /// Present when the session was scoped to one Business Profile rather than the whole workspace.
  businessProfileId  String?  @map("business_profile_id")
  /// The domain's `SupportDataScope` names. Never includes metadata, which needs no session.
  scopes             String[] @default([])
  /// Why, in the operator's words. Required: access nobody can explain is access nobody dares revoke.
  reason             String
  /// The ticket or incident this belongs to, where there is one.
  ticketRef          String?  @map("ticket_ref")
  /// Break-glass: the same unlock with a fifteen-minute ceiling and a CRITICAL audit row.
  breakGlass         Boolean  @default(false) @map("break_glass")
  startedAt          DateTime @map("started_at")
  expiresAt          DateTime @map("expires_at")
  revokedAt          DateTime? @map("revoked_at")
  revokedByMemberId  String?  @map("revoked_by_member_id")
  createdAt          DateTime @default(now()) @map("created_at")

  actor           PlatformMember   @relation("SupportSessionActor", fields: [platformMemberId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revokedBy       PlatformMember?  @relation("SupportSessionRevoker", fields: [revokedByMemberId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Composite, so a profile-scoped session cannot name a profile belonging to another tenant. The
  /// single-column form would make that a runtime check somebody forgets.
  businessProfile BusinessProfile? @relation(fields: [workspaceId, businessProfileId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([platformMemberId, expiresAt])
  @@index([workspaceId, expiresAt])
  @@map("support_access_sessions")
}

/// The internal platform audit, deliberately not `audit_events` (#59).
///
/// Four independent reasons it cannot be that table, and the first two make it impossible rather than
/// merely awkward. `audit_events.workspace_id` is `NOT NULL` with a foreign key, so an action naming no
/// tenant — a global kill switch, a role grant — has no row shape. `audit_events_scope_check` is exact
/// rather than permissive: a kind outside its workspace-scoped allowlist *must* name a Business Profile.
/// `AuditEventKind` contains no operator kind. And `searchAuditEvents` authorizes through a customer's
/// own `WorkspaceContext` and gates sensitivity on the customer's ADMIN role, so internal staff activity
/// filed there would become readable by the customer's owner — the exact inversion the spec forbids.
///
/// What it *does* reuse, deliberately: the append-only trigger pattern, writing the row in the same
/// transaction as the change it describes, and `RESTRICT` on the actor so attribution survives a
/// departure.
model PlatformAuditEvent {
  id                String                @id @default(uuid(7))
  platformMemberId  String                @map("platform_member_id")
  /// The role in force when the action was taken, not the role the person holds now.
  actorRole         PlatformRole          @map("actor_role")
  kind              PlatformAuditKind
  severity          PlatformAuditSeverity
  /// The tenant this was about, where it was about one. NULL for a platform-level act.
  workspaceId       String?               @map("workspace_id")
  businessProfileId String?               @map("business_profile_id")
  /// What the action was about, as a type and an id with no foreign key — the shape `AuditEvent` uses
  /// for the same reason: the subject may be a row somebody later deletes, and an audit row must not
  /// stop a deletion the customer asked for.
  subjectType       String                @map("subject_type")
  subjectId         String                @map("subject_id")
  /// Why. Required for every kind, because an internal action without a stated reason is the thing this
  /// table exists to make impossible.
  reason            String
  /// The session this action was taken under, where one was needed.
  supportSessionId  String?               @map("support_session_id")
  /// Normalized detail only. Never a token, a key, a signing secret or customer message text.
  detail            Json                  @default("{}")
  occurredAt        DateTime              @default(now()) @map("occurred_at")

  actor           PlatformMember   @relation(fields: [platformMemberId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  workspace       Workspace?       @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  businessProfile BusinessProfile? @relation(fields: [workspaceId, businessProfileId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([occurredAt])
  @@index([severity, occurredAt])
  @@index([workspaceId, occurredAt])
  @@map("platform_audit_events")
}

/// The staged rollout of `LAUNCH_READINESS.md` §18, in order (#60).
enum RolloutStage {
  INTERNAL
  DESIGN_PARTNERS_DRAFT
  LIMITED_AUTOPILOT
  COMMERCIAL_BETA
  GENERAL_AVAILABILITY
}

/// `LAUNCH_READINESS.md`'s four release severities (#60).
enum GateSeverity {
  PASS
  KNOWN_LIMITATION
  HIGH
  BLOCKER
}

/// What an independent reviewer said about one exact commit (#60).
enum ReviewVerdict {
  PASS
  CHANGES_REQUESTED
}

/// A release candidate: one immutable commit, and the evidence gathered about it (#60).
///
/// Immutable by trigger, because it is evidence. What is deliberately **not** on it is any stored
/// judgement: there is no `releasable` column and no `reviewerStatus` column, because both are functions
/// of the rows below and a stored copy is a second answer that can disagree with its own inputs.
/// `releaseDecision` and `reviewerStatusOf` recompute them every time they are asked.
model ReleaseRecord {
  id           String       @id @default(uuid(7))
  /// The full 40-character commit SHA. Abbreviated forms are refused by a CHECK: an abbreviation is
  /// exactly how a verdict given to one commit comes to be read as a verdict about another.
  sha          String
  /// Who proposed this release. A person, not a process.
  actorUserId  String       @map("actor_user_id")
  stage        RolloutStage
  /// How to get back. A release with no stated way back is not a plan, so this is required.
  rollbackPlan String       @map("rollback_plan")
  /// The migrations this candidate carries, newest last. Recorded because a rollback has to know.
  migrations   String[]     @default([])
  /// The feature flags enabled for this release, by name.
  enabledFlags String[]     @default([]) @map("enabled_flags")
  /// Free-text context for a human reader: what this release is for.
  summary      String
  createdAt    DateTime     @default(now()) @map("created_at")

  actor   User                @relation("ReleaseActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  results ReleaseGateResult[]

  /// One commit, one record per stage. §18 is a progression, so advancing a build from `LIMITED_AUTOPILOT`
  /// to `COMMERCIAL_BETA` is a second release decision with its own evidence and its own reviewer status —
  /// not an edit to the first, which nothing here can edit anyway. The key also means re-running the
  /// release script for a stage already recorded is refused rather than silently duplicated.
  @@unique([sha, stage])
  @@index([sha])
  @@index([createdAt])
  @@index([stage, createdAt])
  @@map("release_records")
}

/// One launch gate's verdict for one release candidate (#60, LAUNCH_READINESS.md).
///
/// `gateId` is the domain's own gate identifier rather than a foreign key, because the catalogue of gates
/// lives in `packages/domain/src/release.ts` and in the spec — not in a table somebody could edit
/// independently of either. `release-store.integration.test.ts` holds every stored id against the
/// domain's catalogue, and `releaseDecision` reports one it does not define as `UNKNOWN_GATE` rather than
/// ignoring the row — because ignoring it is how a gate removed from the catalogue would make an archived
/// record carrying its `BLOCKER` read as releasable.
///
/// Evidence is required for every severity, including `PASS`: the spec refuses "Claude ran it locally"
/// without recorded commands and results, and a pass with nothing behind it is that claim exactly.
model ReleaseGateResult {
  id        String       @id @default(uuid(7))
  releaseId String       @map("release_id")
  gateId    String       @map("gate_id")
  severity  GateSeverity
  /// What was actually run or read: a command, a CI run URL, a suite name, a signed checklist.
  evidence  String
  /// Why this is acceptable. Required for `KNOWN_LIMITATION` by a CHECK: an unbounded limitation is not one.
  note      String?
  createdAt DateTime     @default(now()) @map("created_at")

  release ReleaseRecord @relation(fields: [releaseId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// One verdict per gate per release. A second would be two answers to one question.
  @@unique([releaseId, gateId])
  @@map("release_gate_results")
}

/// An independent reviewer's verdict, and the commit it was given about (#60).
///
/// Append-only, and `reviewedSha` is deliberately **not** constrained to equal the release's own SHA. That
/// is the inverse of the obvious design and it is the important part: a verdict given to an earlier commit
/// has to be *recordable*, because its existence is the fact somebody needs to see — this repository has
/// had a stale `CHANGES_REQUESTED` sitting on one SHA while the branch head was two commits further on,
/// and the danger was precisely that it read as current.
///
/// So the database records any verdict about any commit, and `reviewerStatusOf` decides which one counts:
/// the newest whose reviewed SHA *is* the release's own, and no other. Forbidding the row would have
/// destroyed the evidence instead of interpreting it.
model ReleaseReview {
  id          String        @id @default(uuid(7))
  /// Who reviewed. Free text: an independent reviewer is not a user of this product.
  reviewer    String
  verdict     ReviewVerdict
  /// The full commit SHA this verdict was given about, and the only thing it is attached to.
  reviewedSha String        @map("reviewed_sha")
  /// Where the verdict can be read: a review URL, a comment link.
  reference   String?
  /// When the reviewer said it. Caller-supplied, and bounded to the past by a trigger — see the migration.
  submittedAt DateTime      @map("submitted_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  @@index([reviewedSha, submittedAt])
  @@map("release_reviews")
}
