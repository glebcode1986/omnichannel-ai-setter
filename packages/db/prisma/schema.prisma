// PostgreSQL persistence model (docs/specs/DATA_MODEL.md, ADR-005, ADR-009).
//
// Conventions:
// - tables/columns are snake_case; Prisma models/fields are PascalCase/camelCase;
// - Workspace is the tenant/billing boundary and Business Profile the operational/customer-data boundary
//   inside it (DATA_MODEL.md v0.4). Every customer-owned table carries `workspace_id`; Business Profile owned
//   tables also carry `business_profile_id`, and references between them are composite foreign keys that
//   include both, so the database itself rejects cross-Workspace and cross-Business-Profile references;
// - uniqueness on tenant tables leads with `workspace_id` (and `business_profile_id` where owned), so a write
//   from one scope can never collide with (and thereby reveal) another scope's rows;
// - history/audit rows use ON DELETE RESTRICT (no destructive cascades); only Auth.js login plumbing cascades;
// - ON UPDATE RESTRICT everywhere: the scope/identifier of a row that other rows reference cannot change.
//   Rows without dependents are not pinned by the database, so repositories never update scope columns;
// - enum values mirror the literal sets in @omnichannel/domain (checked by schema tests);
// - CHECK constraints that Prisma cannot express live in the migration SQL (see prisma/migrations).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------------------------------------
// Enums (mirrors of @omnichannel/domain literal sets)
// ---------------------------------------------------------------------------------------------------------

enum ChannelType {
  INSTAGRAM
  WHATSAPP
}

enum AiMode {
  OFF
  DRAFT
  AUTOPILOT
}

enum WorkspaceRole {
  OWNER
  ADMIN
  AGENT
}

enum BusinessProfileAccessScope {
  ALL
  SELECTED
}

enum BusinessProfileStatus {
  SETUP
  ACTIVE
  INACTIVE
}

/// Steps of the guided setup (ONBOARDING_UX.md). Only the ones a person may legitimately pass over are
/// ever stored; the rest are derived from configuration and never written down.
enum OnboardingStep {
  WORKSPACE
  CHANNELS
  AI_BEHAVIOUR
  KNOWLEDGE
  STYLE
  TIMING_AND_HANDOFF
  CHANNEL_POLICY
  TEST_DRIVE
  ACTIVATION
}

enum ChannelAccountStatus {
  CONNECTED
  /// Verified, but something the provider reports needs attention: quality, or a catalogue we could not read.
  DEGRADED
  NEEDS_REAUTH
  DISCONNECTED
}

/// What a business signals back to a customer while a reply is being prepared (#22).
///
/// Three values rather than two booleans, because the provider does not offer the two independently: the
/// documented request that raises a typing indicator carries the read status as a required field. A pair
/// of booleans would let an owner ask for a combination no channel can perform.
enum PresenceMode {
  /// Say nothing. The customer sees neither a read receipt nor a typing indicator.
  OFF
  /// Mark the customer's message read as soon as the reply is scheduled, and show no typing indicator.
  READ_ON_RECEIPT
  /// Mark read and show the typing indicator shortly before the reply actually goes out.
  READ_AND_TYPING
}

/// What a deletion request covers (#57).
///
/// Four scopes because four different things can be asked for, and collapsing them would make the
/// narrowest request — "forget me" — indistinguishable from the widest. A scope is chosen when the
/// request is made and never widened afterwards.
enum DeletionScope {
  /// One customer and everything derived from them, across every conversation they had.
  CONTACT
  /// One thread. The contact survives, and so does everything learned from their other conversations.
  CONVERSATION
  /// A Business Profile and every customer in it. Distinct from deactivation, which keeps the data.
  BUSINESS_PROFILE
  /// A whole tenant. Records a regulator or a payment provider requires are not customer data and are
  /// retained separately; nothing in this product writes any yet.
  WORKSPACE
}

/// How far a deletion has got, and whether it finished (#57).
///
/// `PARTIAL_FAILURE` is a terminal state of its own rather than a retry: a deletion that removed some
/// things and not others must not read as "done", and must not silently try again on a different
/// schedule — somebody has to look at what was left.
enum DeletionState {
  REQUESTED
  PROCESSING
  COMPLETED
  PARTIAL_FAILURE
}

/// A request to delete customer data, and the durable record of what it actually removed (#57).
///
/// It exists as a row rather than as a function call because a deletion is a promise with a deadline.
/// A process that crashes mid-way must leave evidence of how far it got, an operator must be able to
/// answer "was this done, and when", and a partial failure must be visible rather than retried into
/// silence. The counts are per table and written as the work proceeds.
model DeletionRequest {
  id                String        @id @default(uuid(7))
  workspaceId       String        @map("workspace_id")
  /// Absent for a WORKSPACE-scoped request; set for every narrower one.
  businessProfileId String?       @map("business_profile_id")
  scope             DeletionScope
  /// The contact or conversation the request names. Absent for profile- and workspace-wide requests.
  /// Deliberately not a foreign key: the row it names is the row this request is about to delete.
  targetId          String?       @map("target_id")
  state             DeletionState @default(REQUESTED)
  /// Who asked. A deletion is always somebody's decision, so there is no system-actor variant.
  requestedByUserId String        @map("requested_by_user_id")
  /// Why, in the requester's words. Shown to whoever reviews a partial failure.
  reason            String?
  /// Rows removed per table, written as the work proceeds so a crash leaves evidence of how far it got.
  removed           Json          @default("{}")
  /// Steps that did not complete, by name, with a fixed reason code. Never a provider's prose.
  failures          Json          @default("[]")
  requestedAt       DateTime      @default(now()) @map("requested_at")
  startedAt         DateTime?     @map("started_at")
  completedAt       DateTime?     @map("completed_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  requestedByUser User             @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([workspaceId, state, requestedAt])
  @@unique([workspaceId, id])
  @@map("deletion_requests")
}

/// A workspace's normalized subscription state (#38, ADR-017).
///
/// Six values the product reasons about. A payment provider has its own, and providers disagree with
/// each other, so a provider status is mapped into one of these inside the billing adapter and no
/// feature check ever sees the original string.
enum SubscriptionState {
  TRIALING
  ACTIVE
  /// A renewal payment failed and is being chased. Paid work continues: a failure on Tuesday must not
  /// stop a business answering its customers on Wednesday.
  PAST_DUE
  /// The accepted three-day window after `PAST_DUE` before paid work stops.
  GRACE
  /// Cancelled, with the already-paid period still running.
  CANCELED_PENDING_END
  INACTIVE
}

/// A commercial package, named once and versioned for ever after (#38).
///
/// The definition carries only identity. Everything a subscription actually depends on lives on a
/// `PlanVersion`, because pricing and capacity change and a workspace must be able to stay on the terms
/// it bought.
model PlanDefinition {
  id          String   @id @default(uuid(7))
  /// Stable product code (`starter`, `growth`, `scale`). Never a provider's price identifier.
  code        String   @unique
  name        String
  /// Order on a pricing page. Presentation only; nothing decides anything from it.
  displayOrder Int     @default(0)
  /// Withdrawn plans stay, because workspaces are grandfathered onto their versions.
  retiredAt   DateTime? @map("retired_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  versions PlanVersion[]

  @@map("plan_definitions")
}

/// An immutable snapshot of what one version of a plan grants (#38).
///
/// Immutable is the whole point. A workspace subscribes to a *version*, so editing one would silently
/// change the terms of every workspace on it — which is exactly what grandfathering exists to prevent.
/// A price or capacity change is a new version; the old one stays, retired and still honoured.
model PlanVersion {
  id         String   @id @default(uuid(7))
  planId     String   @map("plan_id")
  /// Monotonic per plan. `(plan, version)` is how a subscription names its terms.
  version    Int
  /// Features this version switches on, as the product's own names.
  features   String[] @default([])
  /// Ceilings on things that exist at once, keyed by the domain's `PlanLimit`.
  limits     Json     @default("{}")
  /// Period allowances, keyed by the domain's `UsageMetric`.
  quotas     Json     @default("{}")
  /// Who may still subscribe to this version (#43). `LEGACY` is grandfathered, never withdrawn.
  availability CatalogAvailability @default(PRIVATE)
  /// When this version stopped being offered to new subscriptions. Existing ones keep it.
  retiredAt  DateTime? @map("retired_at")
  createdAt  DateTime @default(now()) @map("created_at")

  plan          PlanDefinition         @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  subscriptions WorkspaceSubscription[]
  prices        PlanPrice[]
  arrangements  BillingArrangement[]
  checkoutContracts CheckoutContract[]

  @@unique([planId, version])
  @@map("plan_versions")
}

/// Who may subscribe to a catalogue item (#43, PRICING_PACKAGING.md).
enum CatalogAvailability {
  /// Offered on the public pricing page.
  PUBLIC
  /// Exists and is subscribable, but is not advertised: a negotiated or pilot package.
  PRIVATE
  /// Withdrawn from sale. Workspaces on it keep it, and it stays interpretable for ever.
  LEGACY
}

/// How often a price is charged. `ONE_TIME` is a top-up, which is not a subscription at all.
enum BillingInterval {
  MONTH
  YEAR
  ONE_TIME
}

/// What an add-on sells (#43).
enum AddOnKind {
  /// Recurring capacity: one more Business Profile, one more seat.
  RECURRING_CAPACITY
  /// A one-time allowance top-up, bought deliberately and never charged as overage.
  ONE_TIME_ALLOWANCE
}

/// One price for one plan version, in one currency, at one interval (#43).
///
/// A child table rather than columns on the version, because the price book is per currency and per
/// interval and the architecture has to stay multi-currency — two columns and a single `currency` could
/// only ever describe one. The annual amount is stored outright rather than derived from the monthly one:
/// the accepted rule is "pay ten months, receive twelve", and a product that recomputed it would be free
/// to disagree with the invoice a customer already has.
model PlanPrice {
  id            String          @id @default(uuid(7))
  planVersionId String          @map("plan_version_id")
  /// ISO 4217. Nothing assumes EUR for ever.
  currency      String
  interval      BillingInterval
  /// Minor units of `currency`, so no money is ever a float.
  amountCents   Int             @map("amount_cents")
  /// The billing provider's own price object, opaque: nothing parses, compares or branches on it.
  providerPriceId String?       @map("provider_price_id")
  createdAt     DateTime        @default(now()) @map("created_at")

  planVersion PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([planVersionId, currency, interval])
  @@map("plan_prices")
}

/// A self-serve add-on, as a product (#43).
///
/// Separate from the plan it is bought alongside, because an add-on grants capacity or allowance without
/// upgrading the feature class of the base plan — a business on Starter with three extra profiles is
/// still on Starter, and nothing about this table can change that.
model AddOnDefinition {
  id           String    @id @default(uuid(7))
  /// Stable product code. Never a provider's price identifier.
  code         String    @unique
  name         String
  displayOrder Int       @default(0) @map("display_order")
  retiredAt    DateTime? @map("retired_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  versions AddOnVersion[]

  @@map("addon_definitions")
}

/// An immutable snapshot of what one version of an add-on grants (#43).
///
/// Immutable for the same reason a plan version is: a workspace buys a *version*, so editing one would
/// change the terms of every workspace that bought it. `kind` lives here rather than on the definition so
/// that a CHECK can pair it with the grants — recurring capacity grants limits, a top-up grants allowance,
/// and a row claiming both is not a product anybody priced.
model AddOnVersion {
  id           String              @id @default(uuid(7))
  addOnId      String              @map("addon_id")
  version      Int
  kind         AddOnKind
  availability CatalogAvailability @default(PRIVATE)
  /// Capacity this add-on adds, keyed by the domain's `PlanLimit`. Empty for a top-up.
  limits       Json                @default("{}")
  /// Allowance this add-on adds, keyed by the domain's `UsageMetric`. Empty for recurring capacity.
  quotas       Json                @default("{}")
  createdAt    DateTime            @default(now()) @map("created_at")

  addOn      AddOnDefinition  @relation(fields: [addOnId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  prices     AddOnPrice[]
  purchases  WorkspaceAddOn[]
  topUps     UsageTopUp[]

  @@unique([addOnId, version])
  @@map("addon_versions")
}

/// One price for one add-on version. Same shape and same reasoning as `PlanPrice`.
model AddOnPrice {
  id              String          @id @default(uuid(7))
  addOnVersionId  String          @map("addon_version_id")
  currency        String
  interval        BillingInterval
  amountCents     Int             @map("amount_cents")
  providerPriceId String?         @map("provider_price_id")
  createdAt       DateTime        @default(now()) @map("created_at")

  addOnVersion AddOnVersion @relation(fields: [addOnVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([addOnVersionId, currency, interval])
  @@map("addon_prices")
}

/// A recurring add-on a workspace is actually paying for (#43).
///
/// `quantity` rather than one row per unit: "three extra seats" is one decision a person made, and three
/// rows would make removing one of them ambiguous. Removal takes effect at the end of the paid period, so
/// the row is dated rather than deleted — and the entitlement reads only the ones active at the instant
/// it is resolved.
model WorkspaceAddOn {
  id             String    @id @default(uuid(7))
  workspaceId    String    @map("workspace_id")
  addOnVersionId String    @map("addon_version_id")
  quantity       Int       @default(1)
  activeFrom     DateTime  @map("active_from")
  /// When it stops granting anything. Null means it is still being paid for.
  activeUntil    DateTime? @map("active_until")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  addOnVersion AddOnVersion @relation(fields: [addOnVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([workspaceId, addOnVersionId])
  @@index([workspaceId, activeUntil])
  @@map("workspace_addons")
}

/// Allowance a workspace bought on top of its plan's included amount (#43).
///
/// Not part of the plan's quota, and deliberately so: the accepted policy consumes the included allowance
/// first and only then a top-up, and the two expire differently — a plan's allowance resets with the
/// cycle, a top-up carries through the end of the *next* billing period and then lapses. Folding them
/// into one number would make both of those rules unexpressible.
model UsageTopUp {
  id             String          @id @default(uuid(7))
  workspaceId    String          @map("workspace_id")
  metric         UsageMetricKind
  /// What was bought, in the metric's own units.
  amount         Int
  /// What has been spent out of it. Never more than `amount`, by CHECK.
  consumed       Int             @default(0)
  /// Which catalogue item it came from, for reconciliation. Null for a goodwill grant.
  addOnVersionId String?         @map("addon_version_id")
  purchasedAt    DateTime        @map("purchased_at")
  /// End of the next billing period after purchase, under the accepted carry-over rule.
  expiresAt      DateTime        @map("expires_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  addOnVersion AddOnVersion? @relation(fields: [addOnVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// Spending order: the soonest to expire is spent first, so nothing lapses that could have been used.
  @@index([workspaceId, metric, expiresAt])
  @@map("usage_topups")
}

/// What one workspace is subscribed to, in the product's own terms (#38).
model WorkspaceSubscription {
  id            String            @id @default(uuid(7))
  workspaceId   String            @unique @map("workspace_id")
  planVersionId String            @map("plan_version_id")
  state         SubscriptionState @default(TRIALING)
  /// When the current paid or trial period ends. This is when a cancellation or a trial actually bites.
  periodEndsAt  DateTime?         @map("period_ends_at")
  trialEndsAt   DateTime?         @map("trial_ends_at")
  /// When grace began, so its three days can be measured from something durable.
  graceStartedAt DateTime?        @map("grace_started_at")
  canceledAt    DateTime?         @map("canceled_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  planVersion PlanVersion @relation(fields: [planVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([state, periodEndsAt])
  @@map("workspace_subscriptions")
}

/// A deliberate departure from the plan, for one workspace (#38).
///
/// Support grants one, a sales agreement needs one, an incident is apologised for with one. Separate
/// from the plan version because folding it in would mean editing a version — and a version is immutable
/// precisely so the thousand workspaces on it do not move when one of them is helped.
model EntitlementOverride {
  id          String    @id @default(uuid(7))
  workspaceId String    @unique @map("workspace_id")
  features    Json      @default("{}")
  limits      Json      @default("{}")
  quotas      Json      @default("{}")
  /// Why, in the granter's words. An override nobody can explain is one nobody dares remove.
  reason      String
  grantedByUserId String @map("granted_by_user_id")
  /// Absent means it stands until somebody removes it; a lapsed one is kept and stops applying.
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  grantedBy User      @relation(fields: [grantedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("entitlement_overrides")
}

/// A workspace's billing identity, and the opaque references a provider needs (#38, ADR-017).
///
/// The provider's own identifiers live here and nowhere else. They are strings with no meaning to the
/// product: nothing branches on them, nothing displays them, and replacing the provider changes the rows
/// rather than the plan semantics. `provider` is deliberately free text rather than an enum — an enum of
/// provider names in the domain is precisely the leak ADR-017 forbids.
model BillingAccount {
  id          String   @id @default(uuid(7))
  workspaceId String   @unique @map("workspace_id")
  /// Which adapter owns the references below. Absent until a provider is actually integrated.
  provider    String?
  /// Opaque. The product never parses, compares or displays these.
  providerCustomerId     String? @map("provider_customer_id")
  providerSubscriptionId String? @map("provider_subscription_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([provider, providerCustomerId])
  @@map("billing_accounts")
}

/// Who the customer's money legally reaches, and who owes the tax on it (#46, ADR-019).
///
/// Not a provider name and not a jurisdiction — those are configuration. This is the one thing about a
/// route the product itself reasons about, because it decides whose invoice the customer receives.
enum SettlementModel {
  /// A payment processor. We remain the seller of record and we remit the tax.
  DIRECT_PSP
  /// The provider is the seller to the customer and remits the tax. Its invoice, not ours.
  MERCHANT_OF_RECORD
  /// A crypto/prepaid processor: a time-bounded quote in an asset, settled or not.
  CRYPTO_PROCESSOR
}

/// How service is paid for over time (#46, ADR-019).
///
/// A `PREPAID_TERM` buys service until a stated date and nothing more. No renewal is assumed, because
/// assuming one is how a product keeps serving a customer who never agreed to pay again.
enum BillingArrangementKind {
  RECURRING
  PREPAID_TERM
}

/// Where a charge path is in its life (#46).
///
/// `PENDING` is a charge path being opened; it counts as live, which is what the one-live-arrangement
/// index is for. `SUPERSEDED` is the row a provider switch left behind, kept with its references for
/// reconciliation.
enum BillingArrangementState {
  PENDING
  ACTIVE
  ENDED
  SUPERSEDED
}

/// What became of a checkout attempt (#46).
enum CheckoutState {
  OPEN
  SETTLED
  /// The quote's window closed, or the provider reported the attempt expired.
  EXPIRED
  /// Nobody came back. Kept, because the acceptance snapshot it carries is still a record.
  ABANDONED
}

/// The legal documents a checkout may have to be accepted against (#46, ADR-019).
enum LegalDocumentKind {
  TERMS_OF_SERVICE
  PUBLIC_OFFER
  PRIVACY_POLICY
  /// Linked rather than ticked where product configuration requires it (#47). A document that is linked
  /// instead of accepted is simply one whose `requiredForCheckout` is false, so both behaviours fall out
  /// of the same two columns.
  REFUND_POLICY
}

/// A payment, as the product understands it after an adapter has normalized it (#46).
enum BillingEventKind {
  PAYMENT_SETTLED
  PAYMENT_FAILED
  PAYMENT_UNDERPAID
  QUOTE_EXPIRED
  SUBSCRIPTION_RENEWED
  SUBSCRIPTION_CANCELED
  REFUNDED
  CHARGEBACK
}

/// The commercial seller/merchant entity a checkout is made with (#46, ADR-019).
///
/// Separate from the payment provider, because the market separates them: a direct processor leaves us
/// the seller of record while a Merchant of Record *is* the seller to the customer. The same entity can
/// be used through two providers and the same provider by two entities.
///
/// What is stored is what a checkout or a legal document has to display or name. Processor credentials,
/// tax-provider configuration and registration documents are infrastructure: `legalConfigRef` is an
/// opaque pointer into that configuration which nothing here parses.
model SellerProfile {
  id           String   @id @default(uuid(7))
  /// Operator-facing code. Stable, so a route's configuration can be read by a human.
  code         String   @unique
  /// The registered name that appears on an invoice and in a public offer.
  legalName    String   @map("legal_name")
  /// The name a customer sees at checkout, where it differs from the registered one.
  displayName  String   @map("display_name")
  /// ISO 3166-1 alpha-2 of the entity's registration. A CHECK refuses anything else.
  jurisdiction String
  /// Where a customer writes to about an invoice. Required: a seller nobody can reach is not a seller.
  supportEmail String   @map("support_email")
  /// Opaque pointer into infrastructure configuration. Never a secret and never parsed here.
  legalConfigRef String? @map("legal_config_ref")
  /// Withdrawn entities stay: historical checkouts name them, and an invoice must stay interpretable.
  retiredAt    DateTime? @map("retired_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  routes           BillingRoute[]
  checkoutContracts CheckoutContract[]
  legalDocuments   LegalDocument[]

  @@map("seller_profiles")
}

/// One configured way to take money (#46, ADR-019).
///
/// A route is a provider *and* a provider account *and* a seller profile *and* the currencies, intervals
/// and markets that combination may be used for. The client never names one: a checkout asks for a plan,
/// an interval and a currency, and the server selects the route from this table.
///
/// `capabilities` is a normalized list in the product's own vocabulary rather than a provider's feature
/// flags, because the product has to reason about what a route can do without knowing who the provider
/// is. Tax calculation and tax remittance are separate entries on purpose.
model BillingRoute {
  id              String          @id @default(uuid(7))
  code            String          @unique
  /// Which adapter owns this route. Free text, never an enum: an enum of provider names in the product
  /// is precisely the leak ADR-017 forbids.
  provider        String
  /// The provider's own account/configuration object. Opaque; nothing here parses or displays it.
  providerAccountRef String?      @map("provider_account_ref")
  sellerProfileId String          @map("seller_profile_id")
  settlementModel SettlementModel @map("settlement_model")
  /// The domain's `BillingCapability` names. A CHECK holds the coherence rules this product depends on.
  capabilities    String[]        @default([])
  /// The catalogue currencies this route can take a charge for — the base currency, not the settlement
  /// asset. A route with `TIMED_QUOTES` may settle an EUR-priced charge in another asset, and which asset
  /// that is belongs to the quote (#46, ADR-019). Never empty.
  currencies      String[]        @default([])
  /// The catalogue intervals this route charges on. `ONE_TIME` is a top-up, never an arrangement.
  intervals       BillingInterval[] @default([])
  /// ISO 3166-1 alpha-2 markets. Empty means unrestricted.
  markets         String[]        @default([])
  /// Whether the operator has turned this route on. A disabled route admits nothing.
  enabled         Boolean         @default(false)
  /// Order of preference among routes that all admit a request. Lower wins; ties break on `code`.
  priority        Int             @default(0)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  sellerProfile     SellerProfile       @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  arrangements      BillingArrangement[]
  checkoutContracts CheckoutContract[]
  events            BillingEvent[]

  @@index([enabled, priority])
  @@map("billing_routes")
}

/// A workspace's live charge path (#46, ADR-019).
///
/// At most one is live at a time — a partial unique index over `PENDING` and `ACTIVE` says so — which is
/// what makes "one active commercial arrangement must not be double-charged across two providers" an
/// impossibility rather than a rule somebody remembers. A provider switch ends the old row, records
/// `supersededById` on it and opens the new one in the same transaction.
///
/// Bound to its route, so changing the operator's configuration cannot silently move a live subscription
/// to another provider or another selling entity.
model BillingArrangement {
  id             String                  @id @default(uuid(7))
  workspaceId    String                  @map("workspace_id")
  billingRouteId String                  @map("billing_route_id")
  planVersionId  String                  @map("plan_version_id")
  kind           BillingArrangementKind
  state          BillingArrangementState @default(PENDING)
  interval       BillingInterval
  /// What is charged, in minor units of `currency`. Never a float, never derived at read time.
  amountMinor    Int                     @map("amount_minor")
  currency       String
  /// The provider's own subscription/charge object. Opaque, and kept after the arrangement ends so a
  /// reconciliation years later can still find what this was.
  providerReference String?              @map("provider_reference")
  /// When the arrangement actually began paying for service. Set exactly when it became `ACTIVE`.
  startedAt      DateTime?               @map("started_at")
  /// When the paid period ends. Required while a prepaid term is active: a term with no end is a renewal
  /// nobody agreed to.
  currentPeriodEnd DateTime?             @map("current_period_end")
  endedAt        DateTime?               @map("ended_at")
  /// The arrangement that replaced this one, for a provider or seller migration.
  supersededById String?                 @map("superseded_by_id")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  workspace    Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  billingRoute BillingRoute        @relation(fields: [billingRouteId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  planVersion  PlanVersion         @relation(fields: [planVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  supersededBy BillingArrangement? @relation("ArrangementSuccession", fields: [supersededById], references: [id], onDelete: Restrict, onUpdate: Restrict)
  superseded   BillingArrangement[] @relation("ArrangementSuccession")
  checkoutContracts CheckoutContract[]
  events       BillingEvent[]

  /// At most one live charge path per workspace (#46).
  ///
  /// `PENDING` counts as live, because a charge path being opened is a charge path: a second checkout
  /// completing while the first was still open is exactly how a customer ends up on two providers. A
  /// provider switch therefore ends the old arrangement and opens the new one in one transaction.
  ///
  /// Spelled as two inequalities rather than `state IN ('PENDING', 'ACTIVE')` because PostgreSQL rewrites
  /// `IN` into `= ANY (ARRAY[...])` with casts, which `db:check-drift` then reports as a changed index on
  /// every run. The consequence is that a state added later counts as live until somebody says otherwise —
  /// the safe direction, and `billing-routing.integration.test.ts` asserts which states collide so that
  /// the decision is made rather than inherited.
  @@unique([workspaceId], where: raw("state <> 'ENDED' AND state <> 'SUPERSEDED'"), map: "billing_arrangements_one_live_key")
  @@index([workspaceId, state])
  @@map("billing_arrangements")
}

/// The immutable snapshot of what was offered, to whom, by whom, on what terms (#46, ADR-019).
///
/// Written before the customer is sent anywhere near a payment page, and never edited afterwards: a
/// trigger freezes every column except the state, the provider's checkout reference (write-once) and the
/// arrangement it produced. That is what makes it evidence rather than a cache.
///
/// The seller's registered name and jurisdiction are copied in rather than read through the foreign key.
/// Changing a selling entity must not rewrite what a customer was told last March, and a snapshot is
/// exactly what "historical checkouts remain tied to the seller profile that applied" means.
model CheckoutContract {
  id               String        @id @default(uuid(7))
  workspaceId      String        @map("workspace_id")
  /// The person who accepted the terms and opened the checkout.
  actorUserId      String        @map("actor_user_id")
  planVersionId    String        @map("plan_version_id")
  billingRouteId   String        @map("billing_route_id")
  sellerProfileId  String        @map("seller_profile_id")
  /// The seller snapshot. Frozen with the rest of the row.
  sellerLegalName  String        @map("seller_legal_name")
  sellerJurisdiction String      @map("seller_jurisdiction")
  arrangementKind  BillingArrangementKind @map("arrangement_kind")
  interval         BillingInterval
  /// The catalogue's own price for this plan version, in minor units of `baseCurrency`.
  baseAmountMinor  Int           @map("base_amount_minor")
  baseCurrency     String        @map("base_currency")
  /// What this checkout asks the customer for. Equal to the base unless a route quoted another asset.
  chargeAmountMinor Int          @map("charge_amount_minor")
  chargeCurrency   String        @map("charge_currency")
  /// Set only for a quoted charge. After it, the quoted rate is no longer an offer anybody made.
  quoteExpiresAt   DateTime?     @map("quote_expires_at")
  /// The provider's own checkout/session object, attached once after it is created. Opaque.
  providerCheckoutRef String?    @map("provider_checkout_ref")
  state            CheckoutState @default(OPEN)
  /// The arrangement a verified settlement produced. Absent until one did.
  arrangementId    String?       @map("arrangement_id")
  openedAt         DateTime      @map("opened_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  workspace     Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor         User                @relation("CheckoutActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  planVersion   PlanVersion         @relation(fields: [planVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  billingRoute  BillingRoute        @relation(fields: [billingRouteId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sellerProfile SellerProfile       @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  arrangement   BillingArrangement? @relation(fields: [arrangementId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  acceptances   LegalAcceptance[]
  events        BillingEvent[]

  @@index([workspaceId, state])
  @@map("checkout_contracts")
}

/// One version of one legal document (#46, ADR-019).
///
/// The text itself is not here: `contentRef` points at wherever it is published, because a legal document
/// is reviewed, translated and hosted outside this database and copying it in would create a second
/// authority on what it says. What is here is the identity a person accepted, which is what an acceptance
/// record has to name.
///
/// Immutable once written. A correction is a new version, and the old one stays readable because somebody
/// accepted it.
model LegalDocument {
  id              String            @id @default(uuid(7))
  kind            LegalDocumentKind
  /// Monotonic per kind and locale.
  version         Int
  /// BCP-47. The same version of the same document exists in several languages.
  locale          String
  /// Set when this document belongs to one selling entity. NULL applies to every seller profile.
  sellerProfileId String?           @map("seller_profile_id")
  /// Where the published text lives. Opaque to the product.
  contentRef      String            @map("content_ref")
  /// Whether a checkout may not proceed without an acceptance of this kind. A deferred constraint
  /// trigger on `checkout_contracts` enforces it.
  requiredForCheckout Boolean       @default(true) @map("required_for_checkout")
  effectiveFrom   DateTime          @map("effective_from")
  createdAt       DateTime          @default(now()) @map("created_at")

  sellerProfile SellerProfile?    @relation(fields: [sellerProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  acceptances   LegalAcceptance[]

  @@unique([kind, locale, version])
  @@index([kind, effectiveFrom])
  @@map("legal_documents")
}

/// That somebody accepted a named version of a named document, at a named instant (#46, ADR-019).
///
/// Append-only: triggers refuse an update and a delete. The product's evidence of consent is this row and
/// not the later act of payment, which is why it is written before the customer is sent to a payment page
/// — and why a checkout contract cannot commit without one for every required document kind.
model LegalAcceptance {
  id                 String   @id @default(uuid(7))
  workspaceId        String   @map("workspace_id")
  actorUserId        String   @map("actor_user_id")
  legalDocumentId    String   @map("legal_document_id")
  /// The checkout this acceptance was given for. Absent for an acceptance taken outside a checkout.
  checkoutContractId String?  @map("checkout_contract_id")
  /// The locale of the *page* the person accepted on — their own interface language (#47).
  ///
  /// Not the document's locale, which is on the document and may differ: a product that has not
  /// translated its offer shows an English one to a Russian reader, and the question a dispute asks is
  /// "was this person shown terms in a language they read?". That fact is not derivable from the document
  /// row, which only knows what language it is in, so it is recorded here.
  locale             String
  acceptedAt         DateTime @map("accepted_at")
  createdAt          DateTime @default(now()) @map("created_at")

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor            User              @relation("AcceptanceActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  legalDocument    LegalDocument     @relation(fields: [legalDocumentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  checkoutContract CheckoutContract? @relation(fields: [checkoutContractId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  /// One acceptance of one document per checkout. A second click is the same consent, not a second one.
  @@unique([checkoutContractId, legalDocumentId])
  @@index([workspaceId, acceptedAt])
  @@map("legal_acceptances")
}

/// A normalized provider event, recorded once (#46, ADR-019).
///
/// `(route, providerEventId)` is unique, so a replayed or redelivered webhook is refused by an index
/// rather than by a check some caller might skip. The scope is the route and not the workspace because a
/// provider's event identifier is unique within its own account, which is what a route names.
///
/// Append-only. Reconciliation may add a repairing event; it never rewrites one that arrived.
model BillingEvent {
  id                 String           @id @default(uuid(7))
  /// Which workspace this was about, where the event could be attributed to one.
  workspaceId        String?          @map("workspace_id")
  billingRouteId     String           @map("billing_route_id")
  arrangementId      String?          @map("arrangement_id")
  checkoutContractId String?          @map("checkout_contract_id")
  kind               BillingEventKind
  /// The provider's own event identifier, opaque, and the thing idempotency is keyed on.
  providerEventId    String           @map("provider_event_id")
  /// How this became a fact: a verified delivery or an authoritative reconciliation. Never a redirect.
  activationSource   String           @map("activation_source")
  /// What the event says happened, in minor units of `currency`. Absent where no money moved.
  amountMinor        Int?             @map("amount_minor")
  currency           String?
  occurredAt         DateTime         @map("occurred_at")
  receivedAt         DateTime         @default(now()) @map("received_at")
  /// What the store decided this event did. The product's own vocabulary, for the audit trail.
  effect             String
  /// Normalized detail only. No raw provider payload, no signature, no secret.
  detail             Json             @default("{}")

  workspace        Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  billingRoute     BillingRoute        @relation(fields: [billingRouteId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  arrangement      BillingArrangement? @relation(fields: [arrangementId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  checkoutContract CheckoutContract?   @relation(fields: [checkoutContractId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([billingRouteId, providerEventId])
  @@index([workspaceId, occurredAt])
  @@map("billing_events")
}

/// What a usage ledger row is a record of (#39, USAGE_METERING.md).
enum UsageEventKind {
  /// Consumption with nothing held first: telemetry, and metrics that cannot refuse work.
  RECORD
  RESERVE
  COMMIT
  RELEASE
}

enum UsageReservationState {
  /// The only state that still holds allowance.
  RESERVED
  COMMITTED
  RELEASED
}

/// Everything the ledger counts, sold or not.
///
/// `AI_GENERATION_CYCLES` and `SIMULATION_GENERATION_CYCLES` are internal: unit economics, fair use and
/// capacity planning. They are not allowances, and `usage_reservations` refuses them by CHECK — core AI
/// replies are included and unmetered in the public plans, so there must be no path by which an exhausted
/// allowance could hold one.
enum UsageMetricKind {
  VOICE_TRANSCRIPTION_SECONDS
  AI_GENERATION_CYCLES
  SIMULATION_GENERATION_CYCLES
}

/// A metering period with authoritative boundaries (#39).
///
/// A row rather than arithmetic at read time, so a counter can never belong to two periods and so that
/// changing the anchor later cannot re-attribute consumption that has already happened. Half-open
/// `[startsAt, endsAt)`: consecutive cycles tile the timeline exactly.
///
/// Per workspace rather than per metric, because the period is the subscription's — two metrics resetting
/// on different days would make "this month's usage" a question with two answers.
model UsageCycle {
  id          String   @id @default(uuid(7))
  workspaceId String   @map("workspace_id")
  /// The subscription's day of month, remembered rather than clamped: a 31st anchor is the 28th in
  /// February and the 31st again in March.
  anchorDay   Int      @map("anchor_day")
  startsAt    DateTime @map("starts_at")
  endsAt      DateTime @map("ends_at")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  entries      UsageLedgerEntry[]
  counters     UsageCounter[]
  reservations UsageReservation[]

  @@unique([workspaceId, startsAt])
  /// What the children's composite foreign key points at, so a ledger row cannot count one workspace's
  /// consumption into a neighbour's period. Tenancy as structure rather than as a convention every caller
  /// has to remember.
  @@unique([workspaceId, id], map: "usage_cycles_workspace_id_key")
  @@index([workspaceId, endsAt])
  @@map("usage_cycles")
}

/// One thing that happened to a workspace's usage (#39).
///
/// Append-only: nothing in this package updates or deletes a row here, and a correction is another row.
/// Both deltas are carried on every row, so the materialized counters are exactly two column sums — no
/// replay of a per-operation state machine, and therefore no second copy of the rules in the reconciler.
model UsageLedgerEntry {
  id          String          @id @default(uuid(7))
  workspaceId String          @map("workspace_id")
  cycleId     String          @map("cycle_id")
  metric      UsageMetricKind
  kind        UsageEventKind
  /// The logical operation this is part of, derived from facts fixed before the work started. The unique
  /// index below is what makes counting idempotent — not a check in application code, which a second
  /// worker can lose a race against.
  usageOperationId String     @map("usage_operation_id")
  /// Signed effect on the committed total.
  committedDelta Int          @map("committed_delta")
  /// Signed effect on the held total. Negative exactly when a reservation is settled.
  reservedDelta  Int          @map("reserved_delta")
  /// What the operation was about, for reconciliation and for explaining a line to a customer.
  subjectType String?         @map("subject_type")
  subjectId   String?         @map("subject_id")
  detail      Json            @default("{}")
  recordedAt  DateTime        @default(now()) @map("recorded_at")

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cycle     UsageCycle @relation(fields: [workspaceId, cycleId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)

  /// One of each kind per logical operation: a duplicate worker's second RECORD, or a retried COMMIT, is
  /// refused by the database rather than counted.
  @@unique([workspaceId, metric, usageOperationId, kind], map: "usage_ledger_operation_key")
  @@index([workspaceId, cycleId, metric])
  @@index([workspaceId, recordedAt])
  @@map("usage_ledger_entries")
}

/// Materialized totals for one metric in one cycle (#39).
///
/// A convenience, never the record of truth: `reconcileUsageCounters` recomputes these from the ledger and
/// reports every difference rather than silently repairing one, because a counter that healed itself would
/// hide the bug that broke it. The row is also the lock a reservation takes, which is what stops the last
/// unit of an allowance being sold twice.
model UsageCounter {
  id          String          @id @default(uuid(7))
  workspaceId String          @map("workspace_id")
  cycleId     String          @map("cycle_id")
  metric      UsageMetricKind
  committed   Int             @default(0)
  reserved    Int             @default(0)
  updatedAt   DateTime        @updatedAt @map("updated_at")

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cycle     UsageCycle @relation(fields: [workspaceId, cycleId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([workspaceId, cycleId, metric], map: "usage_counters_metric_key")
  @@map("usage_counters")
}

/// Allowance held for work that has not finished (#39).
///
/// Only for metrics a plan actually sells, which a CHECK enforces: reserving against an internal metric is
/// refused rather than quietly succeeding, because a reservation that did nothing would leave its caller
/// believing it had checked something.
model UsageReservation {
  id          String                @id @default(uuid(7))
  workspaceId String                @map("workspace_id")
  cycleId     String                @map("cycle_id")
  metric      UsageMetricKind
  usageOperationId String           @map("usage_operation_id")
  /// What was held. Settling returns exactly this, whatever the work turned out to consume.
  amount      Int
  state       UsageReservationState @default(RESERVED)
  /// What the work actually used. Set only by a commit, and may exceed `amount`.
  committedAmount Int?              @map("committed_amount")
  /// When an unsettled hold is given back, so a crashed worker cannot keep an allowance until the cycle
  /// ends.
  expiresAt   DateTime              @map("expires_at")
  settledAt   DateTime?             @map("settled_at")
  createdAt   DateTime              @default(now()) @map("created_at")

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  cycle     UsageCycle @relation(fields: [workspaceId, cycleId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([workspaceId, metric, usageOperationId], map: "usage_reservations_operation_key")
  @@index([state, expiresAt])
  @@map("usage_reservations")
}

enum WhatsAppOnboardingMode {
  NEW_OR_MIGRATED_CLOUD_NUMBER
  COEXISTENCE_EXISTING_BUSINESS_APP
  /// Meta finished the flow without telling us which of the two it was; never assumed to be either.
  UNKNOWN
}

enum ConversationStatus {
  OPEN
  CLOSED
  ARCHIVED
}

enum LeadStage {
  NEW
  ENGAGED
  QUALIFYING
  QUALIFIED
  BOOKED
  WON
