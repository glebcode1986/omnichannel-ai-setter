# Copy to apps/web/.env.local for local development. Never commit real values.
# NODE_ENV is managed by Next.js (development for `next dev`, production for `next build`/`next start`).
# LOG_LEVEL: debug | info | warn | error (default: info)
LOG_LEVEL=info

# PostgreSQL (ADR-005). Matches the local-only credentials in the root compose.yaml.
DATABASE_URL=postgresql://omnichannel:omnichannel-local-only@127.0.0.1:54329/omnichannel

# Auth.js secret (>= 32 characters). Generate your own, e.g. `openssl rand -base64 32`; never reuse a real one here.
AUTH_SECRET=

# Redis for BullMQ (ADR-005). Matches the local-only service in the root compose.yaml.
REDIS_URL=redis://127.0.0.1:63799

# Encryption of stored provider credentials. Generate your own key, e.g. `openssl rand -base64 32`.
# Rotate by giving the new key a new id; rows record the id they were written with.
CHANNEL_CREDENTIAL_KEY_ID=local-dev-1
CHANNEL_CREDENTIAL_KEY=

# Instagram Login (ADR-006). From the Meta app dashboard; the redirect URI must match Meta exactly and be HTTPS.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://localhost:3000/api/channels/instagram/callback
# APPROVED only once Meta has approved the Human Agent feature for this app; no API reports it.
INSTAGRAM_HUMAN_AGENT_APPROVAL=UNKNOWN
