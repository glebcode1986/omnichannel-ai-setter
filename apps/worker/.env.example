# Copy to apps/worker/.env for local development. Never commit real values.
# NODE_ENV: development | test | production (default: development)
NODE_ENV=development
# LOG_LEVEL: debug | info | warn | error (default: info)
LOG_LEVEL=info
# Redis for BullMQ (ADR-005). Matches the local-only service in the root compose.yaml.
REDIS_URL=redis://127.0.0.1:63799
