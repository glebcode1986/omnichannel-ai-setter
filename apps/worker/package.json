{
  "name": "@omnichannel/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-preserve-output --import tsx --env-file-if-exists=.env src/main.ts",
    "build": "tsx build.ts",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@omnichannel/env": "workspace:*",
    "@omnichannel/observability": "workspace:*",
    "@omnichannel/queue": "workspace:*",
    "bullmq": "5.81.5",
    "ioredis": "5.11.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13"
  }
}
