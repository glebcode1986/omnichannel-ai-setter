{
  "name": "omnichannel-ai-setter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "^24.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @omnichannel/web --filter @omnichannel/worker dev",
    "dev:web": "pnpm --filter @omnichannel/web dev",
    "dev:worker": "pnpm --filter @omnichannel/worker dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0 && pnpm lint:boundaries",
    "lint:boundaries": "tsx scripts/architecture/cli.ts",
    "billing:publish-routes": "tsx scripts/billing/publish-routes.ts",
    "catalog:publish": "tsx scripts/catalog/publish.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "REQUIRE_DB_TESTS=1 vitest run --project @omnichannel/db",
    "test:redis": "REQUIRE_REDIS_TESTS=1 vitest run --project @omnichannel/queue",
    "evals": "pnpm --filter @omnichannel/evals evals",
    "test:e2e": "REQUIRE_DB_TESTS=1 REQUIRE_REDIS_TESTS=1 vitest run --project @omnichannel/worker --project @omnichannel/web",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "release:record": "tsx scripts/release/record.ts",
    "release:review": "tsx scripts/release/review.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.5",
    "@types/node": "^24.13.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
